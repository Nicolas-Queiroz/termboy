        sp = cavaleiro(hh, int(t * 6) % 4, alta)
        cx, cy = W * 0.14, H * 0.67 - hh + 1
        tela.desenhar(sp, cx, cy)
        if 7.9 <= t < 9.0:
            gx, gy = cx + sp.ponta[0], cy + sp.ponta[1]
            q = (t - 7.9) / 1.1
            tam = hh * 0.35 * math.sin(q * math.pi)
            tela.brilho(gx, gy, tam * 1.5, (180, 220, 255), 0.9)
            tela.linha(gx - tam, gy, gx + tam, gy, (255, 255, 255))
            tela.linha(gx, gy - tam, gx, gy + tam, (255, 255, 255))
        brasas(tela, t)
        if t >= 9.4:
            tela.flash((t - 9.4) / 0.6, (0, 0, 0))
        return

    tela.ceu([(0, (4, 2, 8)), (1, (40, 10, 14))])
    estrelas(tela, t, 0.5)
    castelo(tela, W * 0.5, H * 0.9, u * 0.9, (24, 8, 14), t)
    fogo(tela, H, H * 0.28, t)
    brasas(tela, t, 26)
    if t < 10.4:
        tela.flash(1 - (t - 10.0) / 0.4, (0, 0, 0))
    fim = titulo(tela, ["REINO", "DE CINZA"], t, 10.2,
                 [(255, 250, 220), (255, 210, 110), (200, 120, 50), (120, 60, 40)],
                 contorno=(20, 6, 6), sombra=(60, 10, 10), entrada="cair")
    rodape(tela, t, 12.0, "A LENDA DA CHAMA AZUL", fim // 2 + 1, 12.8)

# ======================================================================== registro
ABERTURAS = {
    "elementra": ("Elementra", "monstros e batalhas", 20.0, elementra),
    "turbo": ("Turbo Asfalto", "corrida com pista em pseudo-3D", 16.0, turbo),
    "astro": ("Astro Vértice", "nave espacial e chefe gigante", 16.0, astro),
    "reino": ("Reino de Cinza", "fantasia com castelo e dragão", 16.0, reino),
}
ORDEM_ESTILOS = ["gb", "gbc", "gba"]


def quadro(nome, estilo, t, tamanho=None):
    tela = Tela(estilo, tamanho)
    ABERTURAS[nome][3](tela, t)
    return tela


# ======================================================================== execução
class Teclado:
    """Lê teclas sem bloquear (q, espaço, setas, e)."""

    def __enter__(self):
        self.fd = None
        if termios and sys.stdin.isatty():
            self.fd = sys.stdin.fileno()
            self.antigo = termios.tcgetattr(self.fd)
            tty.setcbreak(self.fd)
        return self

    def __exit__(self, *_):
        if self.fd is not None:
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.antigo)

    def ler(self):
        if self.fd is None:
            return None
        pronto, _, _ = select.select([sys.stdin], [], [], 0)
        return os.read(self.fd, 16).decode(errors="ignore") if pronto else None


def tocar(nome, estado, teclado):
    """Toca uma abertura. Devolve 'fim', 'proxima' ou 'sair'."""
    t0, duracao = time.time(), ABERTURAS[nome][2]
    while True:
        inicio = time.time()
        t = inicio - t0
        if t > duracao:
            return "fim"
        tecla = teclado.ler()
        if tecla:
            if tecla[0] in "qQ" or tecla == "\x1b":
                return "sair"
            if tecla[0] == " " or tecla in ("\x1b[C", "\n", "\r"):
                return "proxima"
            if tecla[0] in "eE":
                i = ORDEM_ESTILOS.index(estado["estilo"])
                estado["estilo"] = ORDEM_ESTILOS[(i + 1) % len(ORDEM_ESTILOS)]
        sys.stdout.write(quadro(nome, estado["estilo"], t).render())
        sys.stdout.flush()
        time.sleep(max(0.0, 1 / FPS - (time.time() - inicio)))


def fila(abertura):
    """Gera as aberturas a tocar: a escolhida em loop, ou sorteadas sem repetir seguidas."""
    anterior = None
    while True:
        if abertura in ABERTURAS:
            yield abertura
            continue
        opcoes = [a for a in ABERTURAS if a != anterior]
        anterior = random.choice(opcoes)
        yield anterior


def executar(abertura, estilo, uma_vez):
    estado = {"estilo": random.choice(ORDEM_ESTILOS) if estilo == "aleatorio" else estilo}

    def restaurar(*_):
        sys.stdout.write("\x1b[0m\x1b[?25h\x1b[2J\x1b[?1049l")
        sys.stdout.flush()

    def ao_encerrar(*_):
        restaurar()
        sys.exit(0)

    signal.signal(signal.SIGTERM, ao_encerrar)
    sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[2J")
    try:
        with Teclado() as teclado:
            for nome in fila(abertura):
                if tocar(nome, estado, teclado) == "sair" or uma_vez:
                    break
                if estilo == "aleatorio":
                    estado["estilo"] = random.choice(ORDEM_ESTILOS)
    except KeyboardInterrupt:
        pass
    finally:
        restaurar()


def listar():
    print("Aberturas:")
    for k, (nome, desc, *_ ) in ABERTURAS.items():
        print(f"  {k:<10} {nome}: {desc}")
    print("  aleatoria  sorteia uma diferente a cada vez (padrão)")
    print("\nEstilos (-e):")
    for k, v in ESTILOS.items():
        print(f"  {k:<10} {v}{'  (padrão)' if k == 'gba' else ''}")
    print("  aleatorio  sorteia a cada abertura")


def main():
    import argparse

    p = argparse.ArgumentParser(
        prog="termboy",
        description="Aberturas animadas de jogos retrô no terminal, no estilo Game Boy / GBA.",
        epilog="Teclas: q sai | espaço ou → pula para a próxima | e troca o estilo",
    )
    p.add_argument("abertura", nargs="?", default="aleatoria", choices=list(ABERTURAS) + ["aleatoria"],
                   help="qual abertura tocar (padrão: aleatoria)")
    p.add_argument("-e", "--estilo", default="gba", choices=list(ESTILOS) + ["aleatorio"],
                   help="estilo de cor (padrão: gba)")
    p.add_argument("-u", "--uma-vez", action="store_true", help="toca uma abertura e sai")
    p.add_argument("-l", "--lista", action="store_true", help="lista aberturas e estilos")
    args = p.parse_args()
    if args.lista:
        listar()
        return
    executar(args.abertura, args.estilo, args.uma_vez)


if __name__ == "__main__":
    main()
