# ======================================================================== execução
def tocar(nome, estado, entrada, saida):
    """Toca uma abertura. Devolve 'fim', 'proxima' ou 'sair'."""
    t0, duracao = time.monotonic(), ABERTURAS[nome][2]
    while True:
        inicio = time.monotonic()
        t = inicio - t0
        if t > duracao:
            return "fim"
        entrada.ler(inicio)
        if entrada.apertou({"q", "esc", "ctrl+c"}):
            return "sair"
        if entrada.apertou({" ", "→", "enter"}):
            return "proxima"
        if entrada.apertou("estilo"):
            estado["estilo"] = proximo_estilo(estado["estilo"])
        entrada.fim_do_tick()
        if estado.pop("redimensionou", False):
            saida.forcar()
        saida.confirmado(entrada.confirmacoes())
        if not saida.pronta(inicio):
            entrada.esperar(0.01)
            continue
        saida.mostrar(quadro(nome, estado["estilo"], t))
        entrada.esperar(1 / FPS - (time.monotonic() - inicio))


def proximo_estilo(estilo):
    return ORDEM_ESTILOS[(ORDEM_ESTILOS.index(estilo) + 1) % len(ORDEM_ESTILOS)]


def fila(abertura):
    """Gera as aberturas a tocar: a escolhida em loop, ou sorteadas sem repetir seguidas."""
    anterior = None
    while True:
        if abertura in ABERTURAS:
            yield abertura
            continue
        opcoes = [a for a in ABERTURAS if a != anterior]
        anterior = random.choice(opcoes)
        yield anterior


class Terminal:
    """Tela alternativa, cursor escondido, teclado e SIGWINCH/SIGTERM; tudo desfeito na saída."""

    def __init__(self, estado, kitty=False):
        self.estado = estado
        self.entrada = Entrada(kitty=kitty)
        self.saida = Saida()

    def __enter__(self):
        signal.signal(signal.SIGTERM, self._sigterm)
        if hasattr(signal, "SIGWINCH"):
            signal.signal(signal.SIGWINCH, self._sigwinch)
        _escrever_stdout("\x1b[?1049h\x1b[?25l\x1b[2J")
        self.entrada.__enter__()
        self.saida.confirmar = self.entrada.fd is not None
        return self

    def __exit__(self, *_):
        self.entrada.__exit__()
        _escrever_stdout("\x1b[0m\x1b[?25h\x1b[2J\x1b[?1049l")

    def _sigwinch(self, *_):
        self.estado["redimensionou"] = True  # o laço principal redesenha; nada de desenhar aqui

    def _sigterm(self, *_):
        self.__exit__()
        sys.exit(0)


def executar(abertura, estilo, uma_vez):
    estado = {"estilo": random.choice(ORDEM_ESTILOS) if estilo == "aleatorio" else estilo}
    try:
        with Terminal(estado) as term:
            for nome in fila(abertura):
                if tocar(nome, estado, term.entrada, term.saida) == "sair" or uma_vez:
                    break
                if estilo == "aleatorio":
                    estado["estilo"] = random.choice(ORDEM_ESTILOS)
    except KeyboardInterrupt:
        pass


def jogar(jogos, estilo, semente=None, gravar=None):
    estado = {"estilo": random.choice(ORDEM_ESTILOS) if estilo == "aleatorio" else estilo}
    fl = Fliperama(jogos, estado, semente=semente, gravar=gravar)
    try:
        with Terminal(estado, kitty=True) as term:
            laco = Laco(term.entrada, term.saida)

            def atualizar(dt, ent):
                if estado.pop("redimensionou", False):
                    laco.redimensionou = True
                return fl.atualizar(dt, ent)

            laco.rodar(atualizar, fl.desenhar)
    except KeyboardInterrupt:
        pass


def assistir(caminho, estilo):
    """Toca um replay gravado com --gravar, no ritmo do jogo."""
    with open(caminho) as f:
        dados = json.load(f)
    estado = {"estilo": estilo if estilo in ESTILOS else "gba"}
    try:
        with Terminal(estado) as term:
            for _, jogo in replay(dados):
                inicio = time.monotonic()
                term.entrada.ler(inicio)
                if term.entrada.apertou({"q", "esc", "ctrl+c"}):
                    break
                term.entrada.fim_do_tick()
                if estado.pop("redimensionou", False):
                    term.saida.forcar()
                term.saida.confirmado(term.entrada.confirmacoes())
                if term.saida.pronta(inicio):
                    tela = Tela(estado["estilo"])
                    jogo.desenhar(tela)
                    tela.texto(0, "REPLAY", (255, 90, 90), coluna=1)
                    term.saida.mostrar(tela)
                term.entrada.esperar(PASSO - (time.monotonic() - inicio))
    except KeyboardInterrupt:
        pass


