ACOES = {
    "pular": {" ", "w", "↑", "k", "z"},
    "acao": {" ", "z", "x", "enter"},
    "cima": {"w", "↑", "k"},
    "baixo": {"s", "↓", "j"},
    "esquerda": {"a", "←", "h"},
    "direita": {"d", "→", "l"},
    "start": {"enter", " "},
    "pausa": {"p", "esc"},
    "sair": {"q", "ctrl+c"},
    "estilo": {"e"},
    "proxima": {"tab", "→", "n"},
}
_CSI = re.compile(r"\x1b\[([?>]?[0-9:;]*)([A-Za-z~])|\x1bO([A-D])|\x1b(.)?", re.S)
_SETAS = {"A": "↑", "B": "↓", "C": "→", "D": "←"}
_CODIGOS = {13: "enter", 27: "esc", 32: " ", 9: "tab", 127: "backspace"}
_BYTES = {"\r": "enter", "\n": "enter", "\t": "tab", "\x7f": "backspace", "\x03": "ctrl+c"}


def ler_teclas(dados):
    """Decodifica bytes do terminal em eventos (tecla, tipo, kitty).

    tipo: 1 apertou, 2 repetição, 3 soltou. kitty=True quando o evento veio do
    protocolo de teclado do kitty (com tipo explícito); False para bytes comuns,
    cujo "soltou" o chamador estima por tempo."""
    eventos, i = [], 0
    while i < len(dados):
        m = _CSI.match(dados, i)
        if not m:
            ch = dados[i]
            eventos.append((_BYTES.get(ch, ch.lower()), 1, False))
            i += 1
            continue
        i = m.end()
        params, final, ss3, alt = m.groups()
        if ss3:
            eventos.append((_SETAS[ss3], 1, False))
        elif final is None:
            eventos.append(("esc", 1, False) if alt is None else (_BYTES.get(alt, alt.lower()), 1, False))
        elif params[:1] in ("?", ">"):
            continue  # respostas de consulta ao terminal
        else:
            partes = params.split(";") if params else []
            mods, tipo = 1, 1
            if len(partes) > 1:
                sub = partes[1].split(":")
                mods = int(sub[0] or 1)
                tipo = int(sub[1]) if len(sub) > 1 and sub[1] else 1
            kitty = len(partes) > 1 and ":" in partes[1] or final == "u"
            if final == "u":
                cod = int(partes[0].split(":")[0] or 0)
                tecla = _CODIGOS.get(cod) or (chr(cod).lower() if 32 < cod < 0xE000 else f"k{cod}")
                if (mods - 1) & 4 and len(tecla) == 1:
                    tecla = "ctrl+" + tecla
            elif final in _SETAS:
                tecla = _SETAS[final]
            else:
                continue
            eventos.append((tecla, tipo, kitty))
    return eventos


class Entrada:
    """Teclado sem bloquear, com apertou/segurando/soltou por tick.

    Modo kitty: o terminal informa apertar, repetir e soltar de verdade.
    Modo fallback: só chegam bytes; a tecla conta como segurada até ESPERA
    segundos depois do último byte (bom para toques, impreciso para segurar)."""

    ESPERA = 0.15

    def __init__(self, acoes=None, kitty=False):
        self.acoes = acoes or ACOES
        self.querer_kitty = kitty
        self.modo = "nenhum"
        self.fd = None
        self.seg = {}  # tecla -> instante do último byte (fallback) ou None (kitty)
        self.apert, self.solt, self.rep = set(), set(), set()
        self.eventos = []  # eventos crus deste tick: (tecla, tipo)
        self._confirmacoes = 0  # respostas "\x1b[0n" do terminal (ver Saida)

    def __enter__(self):
        if termios and sys.stdin.isatty():
            self.fd = sys.stdin.fileno()
            self.antigo = termios.tcgetattr(self.fd)
            tty.setcbreak(self.fd)
            self.modo = "fallback"
            if self.querer_kitty and self._detectar_kitty():
                self.modo = "kitty"
                _escrever_stdout("\x1b[>11u")  # 1 desambiguar + 2 tipos de evento + 8 tudo como escape
        return self

    def __exit__(self, *_):
        self.desligar()
        if self.fd is not None:
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.antigo)
            self.fd = None

    def desligar(self):
        """Devolve o teclado ao normal. Seguro chamar mais de uma vez (finally e SIGTERM)."""
        if self.modo == "kitty":
            _escrever_stdout("\x1b[<u")
            self.modo = "fallback"

    def _detectar_kitty(self, limite=0.25):
        # Pergunta as flags do kitty e, logo atrás, os atributos do terminal (DA1), que
        # todo terminal responde: se o DA1 chega sem a resposta do kitty, não há suporte.
        _escrever_stdout("\x1b[?u\x1b[c")
        resp, fim = "", time.monotonic() + limite
        while time.monotonic() < fim:
            pronto, _, _ = select.select([self.fd], [], [], max(0.0, fim - time.monotonic()))
            if not pronto:
                break
            resp += os.read(self.fd, 256).decode(errors="ignore")
            if re.search(r"\x1b\[\?[0-9;]*c", resp):
                break
        return re.search(r"\x1b\[\?[0-9]+u", resp) is not None

    def ler(self, agora=None):
        agora = time.monotonic() if agora is None else agora
        if self.fd is not None:
            dados = ""
            while select.select([self.fd], [], [], 0)[0]:
                bloco = os.read(self.fd, 1024)
                if not bloco:
                    break
                dados += bloco.decode(errors="ignore")
            self._confirmacoes += dados.count("\x1b[0n")
            for tecla, tipo, kitty in ler_teclas(dados):
                self.injetar(tecla, tipo, None if kitty else agora)
        for tecla, quando in list(self.seg.items()):
            if quando is not None and agora - quando > self.ESPERA:
                del self.seg[tecla]
                self.solt.add(tecla)

    def confirmacoes(self):
        """Quantas respostas de quadro chegaram desde a última consulta."""
        n, self._confirmacoes = self._confirmacoes, 0
        return n

    def esperar(self, segundos):
        """Dorme até `segundos`, mas acorda assim que chega uma tecla ou resposta."""
        if segundos <= 0:
            return
        if self.fd is not None:
            select.select([self.fd], [], [], segundos)
        else:
            time.sleep(segundos)

    def injetar(self, tecla, tipo=1, quando=None):
        """Registra um evento. quando=None: evento com tipo exato (kitty, replay, teste)."""
        self.eventos.append((tecla, tipo))
        if tipo == 3:
            self.seg.pop(tecla, None)
            self.solt.add(tecla)
            return
        if tipo == 2 or (quando is not None and tecla in self.seg):
            self.rep.add(tecla)
        else:
            self.apert.add(tecla)
        self.seg[tecla] = quando

    def _teclas(self, acao):
        if isinstance(acao, (set, frozenset)):
            return acao
        return self.acoes.get(acao, {acao})

    def apertou(self, acao, repetir=False):
        t = self._teclas(acao)
        return not t.isdisjoint(self.apert) or (repetir and not t.isdisjoint(self.rep))

    def segurando(self, acao):
        return not self._teclas(acao).isdisjoint(self.seg)

    def soltou(self, acao):
        return not self._teclas(acao).isdisjoint(self.solt)

    def algo(self):
        """Alguma tecla foi apertada neste tick?"""
        return bool(self.apert)

    def fim_do_tick(self):
        self.eventos.clear()
        self.apert.clear()
        self.solt.clear()
        self.rep.clear()


