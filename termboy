def parede_tijolos(tela, off=0.0, y0=0, y1=None, escala=1.0, cor=(70, 72, 96), luzes=()):
    """Parede de pedra em tijolos. luzes: [(x, y, raio, força)] em pixels; fora delas fica escuro."""
    y1 = tela.H if y1 is None else y1
    tw, th = max(4, int(8 * escala)), max(2, int(3 * escala))
    base, clara, junta = cor, clarear(cor, 0.12), escurecer(cor, 0.45)
    luzes = [luz for luz in luzes if luz[2] > 0]
    for y in range(max(0, int(y0)), min(tela.H, int(y1))):
        fila = (y - int(y0)) // th
        linha = tela.px[y]
        for x in range(tela.W):
            wx = int(x + off)
            if (y - int(y0)) % th == 0 or (wx + (fila % 2) * (tw // 2)) % tw == 0:
                c = junta
            else:
                c = clara if _hash(wx // tw + fila * 7, fila) > 0.7 else base
            luz = 0.12
            for lx, ly, r, f in luzes:
                d = ((x - lx) ** 2 + ((y - ly) * 1.1) ** 2) / (r * r)
                if d < 1:
                    luz += f * (1 - d)
            linha[x] = tela.c(lerp_cor((4, 3, 8), c, min(1.0, luz)) if luz < 1 else
                              lerp_cor(c, (255, 200, 140), min(0.35, (luz - 1) * 0.3)))


def chama(tela, x, y, tam, t, semente=0):
    """Chama tremulante com núcleo claro, centrada na base (x, y)."""
    tam = max(1.5, tam)
    tremor = 0.8 + 0.25 * math.sin(t * 17 + semente) + 0.15 * math.sin(t * 29 + semente * 2)
    tela.brilho(x, y - tam * 0.6, tam * 3.2, (255, 150, 60), 0.35)
    for k, (cor, f) in enumerate((((230, 70, 20), 1.0), ((255, 160, 40), 0.7), ((255, 240, 170), 0.4))):
        hh = tam * 2.0 * f * tremor
        r = tam * 0.7 * f
        for yy in range(int(y - hh), int(y) + 1):
            q = (y - yy) / max(0.5, hh)
            meia = r * math.sqrt(max(0.0, 1 - q)) * (1 + 0.3 * math.sin(t * 13 + yy + semente))
            if meia > 0.3:
                tela.retangulo(x - meia + math.sin(t * 9 + yy * 0.7 + semente) * q * r * 0.5, yy,
                               x + meia + math.sin(t * 9 + yy * 0.7 + semente) * q * r * 0.5 + 1, yy + 1, cor)


def tocha_parede(tela, x, y, tam, t, semente=0):
    tela.retangulo(x - tam * 0.3, y, x + tam * 0.3 + 1, y + tam * 1.6, (80, 50, 30))
    tela.retangulo(x - tam * 0.5, y, x + tam * 0.5 + 1, y + max(1, tam * 0.3), (60, 60, 70))
    chama(tela, x, y, tam, t, semente)


def faiscas(tela, t, n, cor, x0, x1, y0, y1, semente=0):
    for k in range(n):
        fase = (t * (0.3 + 0.3 * _hash(k, semente)) + _hash(k, semente + 1)) % 1
        x = lerp(x0, x1, _hash(k, semente + 2)) + math.sin(t * 3 + k) * 2
        tela.misturar(x, lerp(y1, y0, fase), cor, 1 - fase)


def tocha_abertura(tela, t):
    W, H = tela.W, tela.H
    piso = int(H * 0.8)
    e = max(1.0, H / 48)
    tam = max(1.5, H * 0.04)
    if t < 3.5:
        acesa = ease((t - 1.0) / 1.5)
        luzes = [(W * 0.5, H * 0.35, max(2, H * 0.5 * acesa), 1.6 * acesa)] if t >= 1.0 else []
        tela.retangulo(0, 0, W, H, (2, 2, 6))
        parede_tijolos(tela, 0, 0, piso, e, luzes=luzes)
        tela.retangulo(0, piso, W, H, (10, 8, 16))
        if t >= 1.0:
            tocha_parede(tela, W * 0.5, H * 0.35, tam * acesa, t)
        else:
            q = t / 1.0
            tela.brilho(W * 0.5, H * 0.35, tam * 2, (255, 180, 80), q * 0.8)
        if 1.6 <= t <= 3.4:
            a = min(1, (t - 1.6) / 0.4, (3.4 - t) / 0.4)
            tela.texto(tela.rows // 6, "As profundezas guardam um segredo...", lerp_cor((10, 8, 20), (210, 200, 220), a))
        return
    if t < 10.0:
        off = (t - 3.5) * W * 0.06
        tx = [W * f - off for f in (0.1, 0.35, 0.6, 0.85, 1.1)]
        hm = int(min(H * 0.38, W * 0.2))
        mx = lerp(-hm, W * 0.42, ease((t - 3.5) / 3.0))
        bx, bw = W * 0.62, max(6, hm * 0.8)
        aberto = t >= 7.6
        luzes = [(x, H * 0.32, H * 0.28, 1.2) for x in tx]
        luzes.append((mx + hm * 0.6, piso - hm, H * 0.4, 1.0))
        if aberto:
            luzes.append((bx + bw / 2, piso - bw * 0.5, H * 0.5 * ease((t - 7.6) / 0.6), 1.5))
        parede_tijolos(tela, off, 0, piso, e, luzes=luzes)
        for y in range(piso, H):
            tela.retangulo(0, y, W, y + 1, lerp_cor((40, 34, 52), (10, 8, 16), (y - piso) / max(1, H - piso)))
        for i, x in enumerate(tx):
            tocha_parede(tela, x, H * 0.32, tam, t, i)
        if hm >= 6:
            if aberto:
                q = min(1.0, (t - 7.6) / 0.5)
                for k in range(14):
                    ang = math.pi + k * math.pi / 13
                    r = H * 0.45 * q * (0.6 + 0.4 * _hash(k, 1))
                    tela.linha(bx + bw / 2, piso - bw * 0.5, bx + bw / 2 + math.cos(ang) * r,
                               piso - bw * 0.5 + math.sin(ang) * r, (255, 220, 120), 0.35)
            tela.sombra(bx + bw / 2, piso, bw * 0.6, max(1, bw * 0.08))
            tela.desenhar(bau(bw, aberto), bx, piso - int(bw * 0.7))
            if t >= 8.0:
                q = ease((t - 8.0) / 1.0)
                cy = lerp(piso - bw * 0.5, piso - bw * 0.5 - H * 0.3, q) + math.sin(t * 3) * 1.5
                tela.brilho(bx + bw / 2, cy, H * 0.18, (120, 200, 255), 0.7)
                c = cristal(hm * 0.4)
                tela.desenhar(c, bx + bw / 2 - c.w / 2, cy - c.h / 2)
                faiscas(tela, t, 10, (200, 240, 255), bx - bw * 0.3, bx + bw * 1.3, cy - H * 0.2, cy + H * 0.15)
            andando = mx < W * 0.42 - 1
            sp = mago(hm, int(t * 6) % 4 if andando else 0)
            tela.sombra(mx + hm * 0.38, piso, hm * 0.35, max(1, hm * 0.06))
            tela.desenhar(sp, mx, piso - hm + 1)
            chama(tela, mx + sp.ponta[0], piso - hm + 1 + sp.ponta[1], tam * 0.8, t, 7)
        faiscas(tela, t, 14, (255, 170, 80), 0, W, 0, piso, 3)
        if t >= 9.4:
            tela.flash((t - 9.4) / 0.6, (0, 0, 0))
        return
    luzes = [(W * f, H * 0.62, H * 0.42, 1.3) for f in (0.08, 0.38, 0.62, 0.92)]
    luzes.append((W * 0.72, H * 0.72, H * 0.3, 0.9 + 0.2 * math.sin(t * 3)))
    parede_tijolos(tela, 0, 0, piso, e, luzes=luzes)
    tela.retangulo(0, piso, W, H, (14, 10, 22))
    for i, f in enumerate((0.08, 0.38, 0.62, 0.92)):
        x = W * f
        tela.retangulo(x - tam * 0.5, H * 0.62, x + tam * 0.5 + 1, piso + 1, (70, 44, 26))
        chama(tela, x, H * 0.62, tam * 1.6, t, i)
    if t < 10.4:
        tela.flash(1 - (t - 10.0) / 0.4, (0, 0, 0))
    fim = titulo(tela, ["TOCHA", "ETERNA"], t, 10.2, [(255, 250, 210), (255, 200, 90), (200, 110, 40)],
                 contorno=(20, 10, 4), sombra=(60, 30, 10), entrada="revelar")
    if t >= 11.0:
        hc = max(4, int(min(H * 0.18, piso - fim - 4)))
        cy = (fim + piso) / 2 + math.sin(t * 2.5) * 2
        tela.brilho(W * 0.72, cy, hc * 1.6, (120, 200, 255), 0.6 * ease((t - 11.0) / 0.8))
        c = cristal(hc)
        tela.desenhar(c, W * 0.72 - c.w / 2, cy - c.h / 2)
        faiscas(tela, t, 8, (200, 240, 255), W * 0.6, W * 0.84, cy - hc, cy + hc, 9)
    faiscas(tela, t, 20, (255, 170, 80), 0, W, fim, piso, 5)
    rodape(tela, t, 11.8, "UMA AVENTURA NAS PROFUNDEZAS", fim // 2 + 1, 12.6)


