def castelo(tela, cx, base, u, cor, t):
    janela = (255, 190, 90)
    tela.retangulo(cx - 3.6 * u, base - 4.5 * u, cx + 3.6 * u, base + 1, cor)
    for k in range(-7, 8, 2):
        tela.retangulo(cx + k * u * 0.5 - u * 0.2, base - 5.1 * u, cx + k * u * 0.5 + u * 0.2, base - 4.5 * u, cor)
    for pos, alt, larg in ((-3.0, 7, 1.6), (-1.5, 9.5, 1.5), (0.0, 12, 2.0), (1.5, 9, 1.5), (3.0, 6.5, 1.6)):
        x0, x1 = cx + pos * u - larg * u / 2, cx + pos * u + larg * u / 2
        tela.retangulo(x0, base - alt * u, x1, base + 1, cor)
        tela.poligono([(x0 - u * 0.2, base - alt * u), (x1 + u * 0.2, base - alt * u),
                       ((x0 + x1) / 2, base - alt * u - larg * u * 1.4)], cor)
        for k in range(3):
            wy = base - alt * u * (0.35 + k * 0.2)
            if _hash(int(pos * 10) + k, int(t * 2)) > 0.35:
                tela.retangulo((x0 + x1) / 2 - max(0.5, u * 0.2), wy, (x0 + x1) / 2 + max(0.5, u * 0.2), wy + max(1, u * 0.5), janela)


def fogo(tela, base, altura, t, larg_x0=0, larg_x1=None):
    larg_x1 = tela.W if larg_x1 is None else larg_x1
    for x in range(int(larg_x0), int(larg_x1)):
        hh = altura * (0.35 + 0.65 * fbm(x * 0.12, t * 2.5, 2))
        for y in range(int(base - hh), int(base) + 1):
            f = (base - y) / max(1, hh)
            c = cor_em([(0, (255, 245, 190)), (0.3, (255, 190, 60)), (0.65, (230, 80, 30)), (1, (120, 20, 20))], f)
            tela.misturar(x, y, c, 1 - f ** 2.5)


def brasas(tela, t, n=18, y_base=None):
    y_base = tela.H if y_base is None else y_base
    for k in range(n):
        fase = (t * (0.25 + 0.2 * _hash(k, 1)) + _hash(k, 2)) % 1
        x = _hash(k, 3) * tela.W + math.sin(t * 2 + k) * 3
        y = lerp(y_base, 0, fase)
        tela.brilho(x, y, 1.5, (255, 150 + int(80 * _hash(k, 4)), 60), 1 - fase)


def reino(tela, t):
    W, H = tela.W, tela.H
    u = max(1.2, min(W * 0.03, H * 0.045))
    if t < 4.0:
        raio = (0.8 <= t < 1.1) or (2.4 <= t < 2.8)
        tela.ceu([(0, (6, 6, 14)), (1, (26, 24, 44))])
        silh = (40, 38, 62) if raio else (14, 12, 24)
        castelo(tela, W * 0.62, H * 0.66, u, silh, t)
        tela.poligono([(0, H * 0.62), (W * 0.35, H * 0.58), (W * 0.5, H * 0.66), (W * 0.9, H * 0.64),
                       (W, H * 0.7), (W, H), (0, H)], (10, 8, 16) if not raio else (30, 28, 44))
        if raio and int(t * 20) % 2 == 0:
            tela.flash(0.45, (220, 225, 255))
            x, y = W * (0.8 if t < 2 else 0.4), 0.0
            while y < H * 0.45:
                nx, ny = x + (_hash(int(y), int(t)) - 0.5) * u * 4, y + u * 1.5
                tela.linha(x, y, nx, ny, (255, 255, 255))
                tela.linha(x + 1, y, nx + 1, ny, (200, 210, 255), 0.6)
                x, y = nx, ny
        for k in range(70):
            x = (_hash(k, 1) * W + t * W * 0.35) % W
            y = (_hash(k, 2) * H + t * H * 1.8) % H
            tela.linha(x, y, x - 1, y + 2, (150, 170, 210), 0.5)
        if 1.4 <= t <= 3.8:
            a = min(1, (t - 1.4) / 0.4, (3.8 - t) / 0.4)
            tela.texto(tela.rows // 5, "Há muito tempo, a chama azul se apagou...", lerp_cor((10, 10, 20), (210, 215, 235), a))
        return
    if t < 10.0:
        tela.ceu([(0, (20, 8, 30)), (0.55, (120, 30, 40)), (1, (230, 110, 50))])
        lx, ly, lr = W * 0.55, H * 0.3, max(3, H * 0.2)
        tela.brilho(lx, ly, lr * 2.2, (255, 200, 160), 0.4)
        tela.circulo(lx, ly, lr, (250, 225, 190))
        tela.circulo(lx + lr * 0.3, ly - lr * 0.25, lr * 0.2, (230, 200, 165))
        if 4.5 <= t < 7.8:
            q = (t - 4.5) / 3.3
            hd = int(min(H * 0.36, W * 0.2))
            tela.desenhar(dragao(hd, int(t * 5) % 2), lerp(W * 1.05, -hd * 1.8, q), H * 0.12 + math.sin(t * 3) * H * 0.04)
        castelo(tela, W * 0.72, H * 0.68, u * 0.8, (40, 14, 26), t)
        penhasco = [(0, H * 0.7), (W * 0.32, H * 0.66), (W * 0.42, H * 0.74), (W * 0.42, H), (0, H)]
        tela.poligono([(W * 0.4, H * 0.8), (W * 0.7, H * 0.76), (W, H * 0.8), (W, H), (W * 0.4, H)], (30, 12, 20))
        tela.poligono(penhasco, (16, 8, 14))
        hh = int(min(H * 0.48, W * 0.3))
        alta = t >= 7.8
        sp = cavaleiro(hh, int(t * 6) % 4, alta)
        cx, cy = W * 0.14, H * 0.67 - hh + 1
        tela.desenhar(sp, cx, cy)
        if 7.9 <= t < 9.0:
            gx, gy = cx + sp.ponta[0], cy + sp.ponta[1]
            q = (t - 7.9) / 1.1
            tam = hh * 0.35 * math.sin(q * math.pi)
            tela.brilho(gx, gy, tam * 1.5, (180, 220, 255), 0.9)
            tela.linha(gx - tam, gy, gx + tam, gy, (255, 255, 255))
            tela.linha(gx, gy - tam, gx, gy + tam, (255, 255, 255))
        brasas(tela, t)
        if t >= 9.4:
            tela.flash((t - 9.4) / 0.6, (0, 0, 0))
        return

    tela.ceu([(0, (4, 2, 8)), (1, (40, 10, 14))])
    estrelas(tela, t, 0.5)
    castelo(tela, W * 0.5, H * 0.9, u * 0.9, (24, 8, 14), t)
    fogo(tela, H, H * 0.28, t)
    brasas(tela, t, 26)
    if t < 10.4:
        tela.flash(1 - (t - 10.0) / 0.4, (0, 0, 0))
    fim = titulo(tela, ["REINO", "DE CINZA"], t, 10.2,
                 [(255, 250, 220), (255, 210, 110), (200, 120, 50), (120, 60, 40)],
                 contorno=(20, 6, 6), sombra=(60, 10, 10), entrada="cair")
    rodape(tela, t, 12.0, "A LENDA DA CHAMA AZUL", fim // 2 + 1, 12.8)

