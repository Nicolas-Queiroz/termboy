def hud_centro(tela, txt, y, s, cor, contorno=(20, 12, 30)):
    hud_texto(tela, txt, (tela.W - (len(txt) * 6 - 1) * s) // 2, y, s, cor, contorno)


def escala_hud(tela, txt, frac=0.7):
    return max(1, min(int(tela.W * frac / max(1, len(txt) * 6 - 1)), int(tela.H / 12)))


class Fliperama:
    """Máquina de estados do modo jogo.

    ABERTURA ──start──▶ JOGANDO ──p──▶ PAUSA
        ▲                  │
        └── RECORDE ◀── FIM (game over, 2 s de CONTINUE?)

    Sem ninguém apertar, a abertura recomeça (ou passa para o próximo jogo): modo atração."""

    T_CONTINUE = 2.0

    def __init__(self, jogos, estado, recordes=None, semente=None, gravar=None):
        self.jogos, self.estado = list(jogos), estado
        self.recordes = recordes or Recordes()
        self.semente_fixa, self.gravar = semente, gravar
        self.i, self.modo, self.t = 0, "abertura", 0.0
        self.jogo, self.pequeno, self.posicao = None, False, None
        self.tick, self.eventos, self.modo_entrada = 0, [], "kitty"

    @property
    def chave(self):
        return self.jogos[self.i]

    def comecar(self):
        semente = self.semente_fixa if self.semente_fixa is not None else random.randrange(1 << 30)
        self.jogo = JOGOS[self.chave]()
        self.jogo.iniciar(semente)
        self.modo, self.t, self.tick, self.eventos = "jogando", 0.0, 0, []

    def _gravar_tick(self, ent):
        self.modo_entrada = ent.modo
        for tipo, teclas in ((1, ent.apert), (2, ent.rep), (3, ent.solt)):
            for tecla in sorted(teclas):
                self.eventos.append([self.tick, tecla, tipo])

    def _encerrar(self):
        pontos = self.jogo.pontos()
        self.posicao = self.recordes.registrar(self.chave, pontos)
        self.ultimos_pontos = pontos
        if self.gravar:
            dados = {"jogo": self.chave, "semente": self.jogo.semente, "modo": self.modo_entrada,
                     "ticks": self.tick, "pontos": pontos, "eventos": self.eventos}
            with open(self.gravar + ".tmp", "w") as f:
                json.dump(dados, f)
            os.replace(self.gravar + ".tmp", self.gravar)

    def atualizar(self, dt, ent):
        if ent.apertou({"q", "ctrl+c"}):
            return "sair"
        if ent.apertou("estilo"):
            self.estado["estilo"] = proximo_estilo(self.estado["estilo"])
        self.t += dt
        if self.modo == "abertura":
            if ent.apertou("start") and self.t > 0.3:
                self.comecar()
            elif ent.apertou("esc"):
                return "sair"
            elif ent.apertou({"tab", "n", "→"}) or self.t > ABERTURAS[JOGOS[self.chave].abertura][2]:
                self.i, self.t = (self.i + 1) % len(self.jogos), 0.0
        elif self.modo == "jogando":
            if ent.apertou("pausa"):
                self.modo = "pausa"
            elif not self.pequeno:
                self._gravar_tick(ent)
                r = self.jogo.atualizar(dt, ent)
                self.tick += 1
                if r == "fim":
                    self.modo, self.t = "fim", 0.0
        elif self.modo == "pausa":
            if ent.apertou("pausa") or ent.apertou("start"):
                self.modo = "jogando"
        elif self.modo == "fim":
            if self.t > 0.5 and ent.apertou("start"):
                self._encerrar()
                self.comecar()
            elif self.t > self.T_CONTINUE + 0.5:
                self._encerrar()
                self.modo, self.t = "recorde", 0.0
        elif self.modo == "recorde":
            if (self.t > 1.0 and ent.algo()) or self.t > 6.0:
                self.modo, self.t = "abertura", 0.0
        return None

    def desenhar(self, tela=None):
        tela = tela or Tela(self.estado["estilo"])
        self.pequeno = tela.cols < TAM_MIN[0] or tela.rows < TAM_MIN[1]
        if self.modo == "abertura":
            ABERTURAS[JOGOS[self.chave].abertura][3](tela, self.t)
            dica = "enter joga   tab outro jogo   q sai" if len(self.jogos) > 1 else "enter joga   q sai"
            tela.texto(tela.rows - 1, dica, (170, 170, 200))
        elif self.pequeno and self.modo in ("jogando", "pausa", "fim"):
            tela_pequena(tela)
        elif self.modo == "recorde":
            self._desenhar_recordes(tela)
        else:
            self.jogo.desenhar(tela)
            if self.modo == "pausa":
                tela.flash(0.55, (0, 0, 0))
                hud_centro(tela, "PAUSA", tela.H // 2 - 6, escala_hud(tela, "PAUSA", 0.4), (255, 255, 255))
                tela.texto(tela.rows - 2, "p continua   q sai", (255, 255, 255))
            elif self.modo == "fim":
                tela.flash(min(0.6, self.t), (0, 0, 0))
                s = escala_hud(tela, "GAME OVER", 0.6)
                hud_centro(tela, "GAME OVER", tela.H // 2 - 6 * s, s, (255, 90, 90))
                if self.t > 0.5:
                    n = max(1, math.ceil(self.T_CONTINUE + 0.5 - self.t))
                    hud_centro(tela, f"CONTINUE? {n}", tela.H // 2 + 2 * s, max(1, s // 2 + 1), (255, 230, 140))
                    tela.texto(tela.rows - 2, "enter joga de novo", (255, 255, 255))
        return tela

    def _desenhar_recordes(self, tela):
        tela.ceu([(0, (14, 8, 40)), (1, (60, 20, 80))])
        estrelas(tela, self.t, vel=3)
        s = escala_hud(tela, "RECORDES", 0.5)
        hud_centro(tela, "RECORDES", 3, s, (255, 220, 120))
        tab = self.recordes.tabela(self.chave)
        lin = (6 * s + 5) // 2 + 2
        tela.texto(lin - 1, JOGOS[self.chave].titulo.upper(), (200, 200, 230))
        for k, r in enumerate(tab):
            destaque = k == self.posicao and int(self.t * 4) % 2 == 0
            cor = (255, 255, 120) if destaque else (255, 255, 255)
            tela.texto(lin + 1 + k, f"{k + 1}.  {r['pontos']:>8}   {r['data']}", cor)
        if self.posicao == 0:
            hud_centro(tela, "NOVO RECORDE!", tela.H - 14, 1, (120, 255, 160))
        tela.texto(tela.rows - 1, f"sua pontuação: {getattr(self, 'ultimos_pontos', 0)}", (200, 200, 230))


def replay(dados):
    """Toca uma partida gravada, devolvendo o jogo a cada tick (determinístico)."""
    jogo = JOGOS[dados["jogo"]]()
    jogo.iniciar(dados["semente"])
    ent = Entrada()
    ent.modo = dados.get("modo", "kitty")
    por_tick = {}
    for tick, tecla, tipo in dados["eventos"]:
        por_tick.setdefault(tick, []).append((tecla, tipo))
    for tick in range(dados["ticks"]):
        for tecla, tipo in por_tick.get(tick, ()):
            ent.injetar(tecla, tipo)
        r = jogo.atualizar(PASSO, ent)
        ent.fim_do_tick()
        yield tick, jogo
        if r == "fim":
            return


