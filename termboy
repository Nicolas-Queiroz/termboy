                tela.brilho(bx, by, fl * 0.7, (255, 255, 255), 0.9)
            for k in range(24):
                ang = k * 2 * math.pi / 24 + _hash(k, 3) * 0.3
                fase = (t * 2.5 + _hash(k, 9)) % 1
                r1, r2 = lerp(0.2, 1.3, fase) * W, lerp(0.3, 1.5, fase) * W
                if math.sin(ang) > -0.2:
                    tela.linha(W / 2 + math.cos(ang) * r1 * 0.5, hz + math.sin(ang) * r1 * 0.3,
                               W / 2 + math.cos(ang) * r2 * 0.5, hz + math.sin(ang) * r2 * 0.3, (255, 255, 255), 0.5)
        if t < 3.0:
            tela.flash(0.35, (0, 0, 0))
            lw, lh = W * 0.22, H * 0.14
            lx, ly = W / 2 - lw / 2, H * 0.05
            tela.retangulo(lx, ly, lx + lw, ly + lh, (25, 25, 32))
            tela.retangulo(lx, ly, lx + lw, ly + 1, (90, 90, 100))
            acesas = 0 if t < 0.7 else 1 if t < 1.4 else 2 if t < 2.1 else 3
            for i in range(3):
                bx, by, br = lx + lw * (0.2 + 0.3 * i), ly + lh / 2, max(1.2, lh * 0.32)
                verde = t >= 2.7
                cor = (60, 255, 90) if verde else (255, 40, 40) if i < acesas else (70, 20, 20)
                if verde or i < acesas:
                    tela.brilho(bx, by, br * 3, cor, 0.6)
                tela.circulo(bx, by, br, cor)
            num = "GO!" if t >= 2.7 else str(3 - acesas + 1) if acesas else ""
            if num and acesas:
                s = max(1, int(H * 0.06))
                larg = (len(num) * 6 - 1) * s
                for n, ch in enumerate(num):
                    x, y = W / 2 - larg / 2 + n * 6 * s, H * 0.24
                    tela.letra(ch, x + s, y + s, s, (40, 10, 10))
                    tela.letra(ch, x, y, s, (255, 240, 120) if num != "GO!" else (120, 255, 140))
