@functools.lru_cache(maxsize=32)
def mago(h, passo=0, lado=1):
    """Nox, mago encapuzado de manto roxo segurando um cajado-tocha. lado: 1 direita, -1 esquerda."""
    h = max(6, int(h))
    w = max(5, int(h * 0.75))
    s = Spr(w, h)
    manto = [(46, 20, 82), (78, 38, 128), (112, 62, 170), (150, 100, 205)]
    ab = [0, 0.04, 0, -0.04][passo % 4] * w
    s.poligono([(w * 0.42, h * 0.2), (w * 0.62, h * 0.22), (w * 0.8 + ab, h * 0.98),
                (w * 0.14 - ab, h * 0.98)], manto)
    s.poligono([(w * 0.5, h * 0.0), (w * 0.3, h * 0.14), (w * 0.3, h * 0.36), (w * 0.72, h * 0.36),
                (w * 0.74, h * 0.16)], manto)
    s.ret(w * 0.26, h * 0.62, w * 0.76, h * 0.62 + max(1, h * 0.04), (210, 170, 70))
    s.contorno((20, 8, 34))
    s.elipse(w * 0.6, h * 0.24, w * 0.12, h * 0.08, cor=(14, 6, 20))
    for ex in (0.55, 0.67):
        s.px[(int(w * ex), int(h * 0.24))] = (255, 220, 80)
    s.linha(w * 0.86, h * 0.14, w * 0.86, h * 0.99, (120, 80, 40), max(1, int(h * 0.04)))
    s.ret(w * 0.66, h * 0.44, w * 0.88, h * 0.5, (112, 62, 170))
    if lado < 0:
        espelho = Spr(w, h)
        espelho.px = {(w - 1 - x, y): c for (x, y), c in s.px.items()}
        s = espelho
    s.ponta = ((w * 0.86) if lado > 0 else (w - 1 - w * 0.86), h * 0.1)
    return s


@functools.lru_cache(maxsize=16)
def bau(w, aberto=False):
