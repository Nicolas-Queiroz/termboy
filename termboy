def diagnostico_teclado():
    """Mostra o modo de entrada detectado e os eventos que chegam. Útil dentro do zellij/tmux."""
    nomes = {1: "apertou", 2: "repetiu", 3: "soltou"}
    with Entrada(kitty=True) as ent:
        print(f"modo: {ent.modo}   (aperte teclas; q sai)")
        if ent.modo != "kitty":
            print("sem eventos de soltar tecla: 'soltou' é estimado por tempo")
        sys.stdout.flush()
        while True:
            ent.ler()
            for tecla, tipo in ent.eventos:
                print(f"  {tecla!r:<12} {nomes.get(tipo, tipo)}")
            for tecla in sorted(ent.solt):
                if ent.modo != "kitty":
                    print(f"  {tecla!r:<12} soltou (estimado)")
            sys.stdout.flush()
            if ent.apertou({"q", "ctrl+c"}):
                return
            ent.fim_do_tick()
            time.sleep(0.01)


def main_jogar(argv):
    import argparse

    p = argparse.ArgumentParser(prog="termboy jogar", description="Modo jogo do termboy.",
                                epilog="Teclas: enter começa | p pausa | q sai | e troca o estilo | tab troca de jogo")
    p.add_argument("jogo", nargs="?", choices=list(JOGOS), help="qual jogo (padrão: todos, com tab para trocar)")
    p.add_argument("-e", "--estilo", default="gba", choices=list(ESTILOS) + ["aleatorio"], help="estilo de cor")
    p.add_argument("--semente", type=int, help="semente fixa (mesma fase toda partida)")
    p.add_argument("--gravar", metavar="ARQ", help="grava a última partida como replay em ARQ (json)")
    p.add_argument("--replay", metavar="ARQ", help="assiste a um replay gravado")
    args = p.parse_args(argv)
    if args.replay:
        assistir(args.replay, args.estilo)
        return
    jogar([args.jogo] if args.jogo else list(JOGOS), args.estilo, args.semente, args.gravar)


def main():
    import argparse

    if sys.argv[1:2] == ["jogar"]:
        main_jogar(sys.argv[2:])
        return

    p = argparse.ArgumentParser(
        prog="termboy",
        description="Aberturas animadas de jogos retrô no terminal, no estilo Game Boy / GBA.",
        epilog="Teclas: q sai | espaço ou → pula para a próxima | e troca o estilo",
    )
    p.add_argument("abertura", nargs="?", default="aleatoria", choices=list(ABERTURAS) + ["aleatoria"],
                   help="qual abertura tocar (padrão: aleatoria)")
    p.add_argument("-e", "--estilo", default="gba", choices=list(ESTILOS) + ["aleatorio"],
                   help="estilo de cor (padrão: gba)")
    p.add_argument("-u", "--uma-vez", action="store_true", help="toca uma abertura e sai")
    p.add_argument("-l", "--lista", action="store_true", help="lista aberturas e estilos")
    p.add_argument("--teclado", action="store_true", help="diagnóstico: mostra o modo de teclado e os eventos")
    args = p.parse_args()
    if args.teclado:
        diagnostico_teclado()
        return
    if args.lista:
        listar()
        return
    executar(args.abertura, args.estilo, args.uma_vez)


if __name__ == "__main__":
    main()
