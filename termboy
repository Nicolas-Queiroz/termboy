            wr = max(6, cw * p)
            if p < 1.0:
                tela.desenhar(carro(int(wr), (40, 96, 220)), cxr - wr / 2, ycar - wr * 0.5)
        tela.sombra(cx_carro, H - 1, cw * 0.5, max(1, cw * 0.06), 0.4)
