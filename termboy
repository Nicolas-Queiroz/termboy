def planeta(tela, cx, cy, r):
    tela.brilho(cx, cy, r * 1.4, (90, 200, 255), 0.35)
    ramp = [(14, 40, 60), (24, 80, 110), (40, 130, 160), (90, 190, 210), (170, 235, 245)]
    for y in range(int(cy - r), int(cy + r) + 1):
        for x in range(int(cx - r), int(cx + r) + 1):
            nx, ny = (x + 0.5 - cx) / r, (y + 0.5 - cy) / r
            r2 = nx * nx + ny * ny
            if r2 > 1:
                continue
            nz = math.sqrt(1 - r2)
            d = max(0.0, min(0.999, nx * LUZ[0] + ny * LUZ[1] + nz * LUZ[2]))
            faixa = 0.12 * math.sin(ny * 14 + ruido(x * 0.1, y * 0.3) * 3)
            tela.ponto(x, y, ramp[max(0, min(4, int((d + faixa) * 5)))])
    for k in range(int(r * 7)):
        a = k / (r * 7) * 2 * math.pi
        x, y = cx + math.cos(a) * r * 1.7, cy + math.sin(a) * r * 0.35
        if math.sin(a) > 0 or (x - cx) ** 2 / r ** 2 + (y - cy) ** 2 / r ** 2 > 1:
            tela.ponto(x, y, (240, 180, 110) if k % 3 else (200, 130, 80))


def explosao(tela, x, y, q, tam):
