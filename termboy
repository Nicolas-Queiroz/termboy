                tela.brilho(W / 2 - ch / 2 + ch * fx, y + ch * 0.28, ch * 0.14, (255, 60, 60), 0.5)
    rodape(tela, t, 12.8, "CAMPEONATO MUNDIAL", fim // 2 + 1, 13.6)

