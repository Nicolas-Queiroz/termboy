# ======================================================================== cores
def conv(c, estilo):
    r, g, b = c
    if estilo == "gb":
        lum = 0.299 * r + 0.587 * g + 0.114 * b
        return GB[min(3, int(lum / 64))]
    if estilo == "gbc":
        q = lambda v: min(255, round(v / 85) * 85)
        return (q(r), q(g), q(b))
    q = lambda v: min(255, (int(v) >> 3) << 3)  # GBA: 15 bits de cor
    return (q(r), q(g), q(b))


def lerp(a, b, p):
    return a + (b - a) * p


def lerp_cor(c1, c2, p):
    p = max(0.0, min(1.0, p))
    return tuple(int(lerp(x, y, p)) for x, y in zip(c1, c2))


def clarear(c, f):
    return lerp_cor(c, (255, 255, 255), f)


def escurecer(c, f):
    return lerp_cor(c, (0, 0, 0), f)


def ease(p):
    p = max(0.0, min(1.0, p))
    return 1 - (1 - p) ** 3


def cor_em(stops, p):
    p = max(0.0, min(1.0, p))
    for (p0, c0), (p1, c1) in zip(stops, stops[1:]):
        if p <= p1:
            return lerp_cor(c0, c1, (p - p0) / max(1e-9, p1 - p0))
    return stops[-1][1]


def _hash(i, j):
    n = (i * 374761393 + j * 668265263) & 0xFFFFFFFF
    n = ((n ^ (n >> 13)) * 1274126177) & 0xFFFFFFFF
    return ((n ^ (n >> 16)) & 0xFFFF) / 65535


def ruido(x, y):
    xi, yi = math.floor(x), math.floor(y)
    fx, fy = x - xi, y - yi
    u, v = fx * fx * (3 - 2 * fx), fy * fy * (3 - 2 * fy)
    a, b = _hash(xi, yi), _hash(xi + 1, yi)
    c, d = _hash(xi, yi + 1), _hash(xi + 1, yi + 1)
    return lerp(lerp(a, b, u), lerp(c, d, u), v)


def fbm(x, y, oitavas=3):
    total, amp, norm = 0.0, 1.0, 0.0
    for _ in range(oitavas):
        total += ruido(x, y) * amp
        norm += amp
        x, y, amp = x * 2.03, y * 2.03, amp * 0.5
    return total / norm


# ======================================================================== sprites
_n = math.sqrt(0.55 ** 2 + 0.65 ** 2 + 0.52 ** 2)
LUZ = (-0.55 / _n, -0.65 / _n, 0.52 / _n)


def _dentro(pts, px, py):
    dentro = False
    j = len(pts) - 1
    for i in range(len(pts)):
        xi, yi = pts[i]
        xj, yj = pts[j]
        if (yi > py) != (yj > py) and px < (xj - xi) * (py - yi) / (yj - yi + 1e-9) + xi:
            dentro = not dentro
        j = i
    return dentro


class Spr:
    """Sprite montado com formas sombreadas (luz vindo de cima à esquerda)."""

    def __init__(self, w, h):
        self.w, self.h, self.px = w, h, {}

    def elipse(self, cx, cy, rx, ry, rampa=None, cor=None):
        rx, ry = max(rx, 0.6), max(ry, 0.6)
        feitos = []
        for y in range(int(cy - ry) - 1, int(cy + ry) + 2):
            for x in range(int(cx - rx) - 1, int(cx + rx) + 2):
                nx, ny = (x + 0.5 - cx) / rx, (y + 0.5 - cy) / ry
                r2 = nx * nx + ny * ny
                if r2 > 1:
                    continue
                if rampa:
                    nz = math.sqrt(max(0.0, 1 - r2))
                    d = max(0.0, min(0.999, nx * LUZ[0] + ny * LUZ[1] + nz * LUZ[2]))
                    self.px[(x, y)] = rampa[int(d * len(rampa))]
                else:
                    self.px[(x, y)] = cor
                feitos.append((x, y))
        return feitos

    def poligono(self, pts, rampa, luz="diag"):
        xs, ys = [p[0] for p in pts], [p[1] for p in pts]
        x0, x1, y0, y1 = min(xs), max(xs), min(ys), max(ys)
        for y in range(int(math.floor(y0)), int(y1) + 1):
            for x in range(int(math.floor(x0)), int(x1) + 1):
                if _dentro(pts, x + 0.5, y + 0.5):
                    u = (x + 0.5 - x0) / max(1e-9, x1 - x0)
                    v = (y + 0.5 - y0) / max(1e-9, y1 - y0)
                    d = 1 - v if luz == "vert" else 1 - (0.45 * u + 0.55 * v)
                    d = max(0.0, min(0.999, d))
                    self.px[(x, y)] = rampa[int(d * len(rampa))]

    def ret(self, x0, y0, x1, y1, cor):
        for y in range(int(y0), max(int(y0) + 1, int(y1))):
            for x in range(int(x0), max(int(x0) + 1, int(x1))):
                self.px[(x, y)] = cor

    def linha(self, x0, y0, x1, y1, cor, grossura=1):
        n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
        for i in range(n + 1):
            x, y = lerp(x0, x1, i / n), lerp(y0, y1, i / n)
            for g in range(grossura):
                self.px[(int(x) + g, int(y))] = cor

    def contorno(self, cor):
        mask = set(self.px)
        borda = [p for p in mask if any(
            (p[0] + dx, p[1] + dy) not in mask for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)))]
        for p in borda:
            self.px[p] = cor


