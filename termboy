        tela.desenhar(novelo(max(3, hg * 0.3), [(236, 96, 150), (90, 160, 240), (250, 210, 80)][k % 3]),
                      x + math.sin(t * 2 + k) * 3, y)
    rodape(tela, t, 11.6, "CORRA, PULE, MIE", fim // 2 + 1, 12.4)


