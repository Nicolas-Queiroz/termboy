# ======================================================================== jogos: Pulo do Gato
CHAO = MUNDO_H * 0.8
METRO = 4.0                     # unidades do mundo por metro
G_SUB, G_DESC = 270.0, 440.0    # gravidade maior na descida: o pulo não flutua
PULO, VY_MAX = -100.0, 160.0
COYOTE = BUFFER = 0.1
V0, VMAX, ACEL = 34.0, 66.0, 32.0 / 24000
AR = -PULO / G_SUB + math.sqrt(2 * (PULO * PULO / (2 * G_SUB)) / G_DESC)  # tempo no ar de um pulo inteiro
ALTURA_PULO = PULO * PULO / (2 * G_SUB)


def vel_gato(x):
    return min(VMAX, V0 + max(0.0, x) * ACEL)


def alcance(x):
    """Distância horizontal de um pulo inteiro, do chão ao chão, na velocidade de x."""
    return vel_gato(x) * AR


class Fase:
    """Fase do corredor, gerada sob demanda a partir de pedaços pré-desenhados.

    Cada pedaço tem dificuldade e largura medidas em alcances de pulo na velocidade
    do lugar, e entre pedaços sempre sobra chão para pousar e pular de novo."""

    BALDE = 32.0

    def __init__(self, semente):
        self.rng = random.Random(semente)
        self.buracos, self.caixas, self.plataformas, self.novelos = {}, {}, {}, {}
        self.fim = 0.0
        self._por(self.novelos, 40, (40.0, CHAO - 4, [False]))
        self.fim = 110.0  # começo sempre plano
        self.historico = []  # (x, pedaço): para depurar e testar o gerador

    def _por(self, onde, x, item, larg=0.0):
        for b in range(int(x // self.BALDE), int((x + larg) // self.BALDE) + 1):
            onde.setdefault(b, []).append(item)

    def perto(self, onde, x0, x1):
        vistos = []
        for b in range(int(x0 // self.BALDE) - 1, int(x1 // self.BALDE) + 1):
            for item in onde.get(b, ()):
                if item not in vistos:
                    vistos.append(item)
        return vistos

    def buraco(self, x, w):
        self._por(self.buracos, x, (x, x + w), w)

    def caixa(self, x, alt, w=8.0):
        self._por(self.caixas, x, (x, CHAO - alt, w), w)

    def plataforma(self, x, y, w):
        self._por(self.plataformas, x, (x, y, w), w)

    def fileira(self, x, y, n, passo=4.5):
        for k in range(n):
            self._por(self.novelos, x + k * passo, (x + k * passo, y, [False]))

    def arco(self, x, w, alt):
        """Novelos na parábola de um pulo que atravessa [x, x+w]."""
        for k in range(3):
            q = (k + 1) / 4
            self._por(self.novelos, x + w * q, (x + w * q - 1.5, CHAO - 5 - alt * 4 * q * (1 - q), [False]))

    def garantir(self, ate):
        while self.fim < ate:
            self._pedaco()

    def _pedaco(self):
        r, x = self.rng, self.fim
        R = alcance(x)
        d = min(1.0, x / 30000)
        pedacos = [
            (0.0, self._buraco_curto), (0.0, self._caixa), (0.15, self._duas_caixas),
            (0.25, self._caixa_alta), (0.35, self._buraco_longo), (0.45, self._degraus),
            (0.5, self._plataforma), (0.7, self._buraco_e_caixa),
        ]
        opcoes = [f for dif, f in pedacos if dif <= d + 0.2]
        pesos = [1 + 2 * k / len(opcoes) * d for k in range(len(opcoes))]
        f = r.choices(opcoes, pesos)[0]
        largura, sobra = f(x, R, r)
        self.historico.append((x, f.__name__))
        # chão livre depois do pedaço: o quanto o pulo forçado passa do fim do pedaço
        # (sobra) mais espaço para pousar e ter tempo de pular de novo
        livre = sobra + R * (0.9 + r.random() * 0.7 * (1.1 - d))
        if r.random() < 0.35:
            self.fileira(x + largura + livre * 0.25, CHAO - 4, r.randint(2, 4))
        self.fim = x + largura + livre

    @staticmethod
    def alcance_de_cima(x, alt):
        """Distância de um pulo que sai de `alt` acima do chão e cai no chão."""
        return vel_gato(x) * (-PULO / G_SUB + math.sqrt(2 * (ALTURA_PULO + alt) / G_DESC))

    def sobra_caixa(self, x, alt):
        # pior caso: pular de cima da caixa na beirada
        return max(0.0, self.alcance_de_cima(x, alt) - Gato.W)

    def _buraco_curto(self, x, R, r):
        w = max(7.0, R * r.uniform(0.3, 0.45))
        self.buraco(x, w)
        if r.random() < 0.5:
            self.arco(x, w, ALTURA_PULO)
        return w, 0.0

    def _buraco_longo(self, x, R, r):
        w = R * r.uniform(0.5, 0.62)
        self.buraco(x, w)
        self.arco(x, w, ALTURA_PULO)
        return w, 0.0

    def _caixa(self, x, R, r):
        self.caixa(x, 7)
        return 8.0, self.sobra_caixa(x, 7)

    def _caixa_alta(self, x, R, r):
        self.caixa(x, 13)
        if r.random() < 0.5:
            self.fileira(x + 1.5, CHAO - 17, 1)
        return 8.0, self.sobra_caixa(x, 13)

    def _duas_caixas(self, x, R, r):
        self.caixa(x, 7)
        if r.random() < 0.5:
            self.caixa(x + 8, 7)  # caixa dupla, larga: dá para pousar em cima
            return 16.0, self.sobra_caixa(x, 7)
        vao = self.sobra_caixa(x, 7) + R * r.uniform(0.9, 1.1)
        self.caixa(x + 8 + vao, 7)
        return 16.0 + vao, self.sobra_caixa(x, 7)

    def _degraus(self, x, R, r):
        self.caixa(x, 7)
        self.caixa(x + 8, 13)
        self.fileira(x + 9.5, CHAO - 17, 1)
        return 16.0, self.sobra_caixa(x, 13)

    def _plataforma(self, x, R, r):
        w = R * r.uniform(1.1, 1.35)
        pw = r.uniform(14, 20)
        alt = r.uniform(8, 12)
        self.buraco(x, w)
        self.plataforma(x + (w - pw) / 2, CHAO - alt, pw)
        self.fileira(x + (w - pw) / 2 + 2, CHAO - alt - 4, int(pw // 5))
        return w, max(0.0, self.alcance_de_cima(x, alt) - (w - pw) / 2)

    def _buraco_e_caixa(self, x, R, r):
        w = R * r.uniform(0.3, 0.42)
        self.buraco(x, w)
        vao = R * r.uniform(1.0, 1.2)
        self.caixa(x + w + vao, 7)
        return w + vao + 8, self.sobra_caixa(x, 7)

    def no_buraco(self, a, b):
        """O trecho [a, b] está todo em cima de um buraco?"""
        return any(x0 <= a and b <= x1 for x0, x1 in self.perto(self.buracos, a, b))

    def apoio(self, a, b, y0, y1):
        """Topo mais alto entre y0 e y1 que sustenta o trecho [a, b], ou None."""
        topos = []
        if y0 - 0.01 <= CHAO <= y1 and not self.no_buraco(a, b):
            topos.append(CHAO)
        for bx, top, bw in self.perto(self.caixas, a, b):
            if bx < b and a < bx + bw and y0 - 0.01 <= top <= y1:
                topos.append(top)
        for px, py, pw in self.perto(self.plataformas, a, b):
            if px < b and a < px + pw and y0 - 0.01 <= py <= y1:
                topos.append(py)
        return min(topos) if topos else None


class Gato:
    """Física do gato: só números, para o jogo e o teste de alcançabilidade usarem a mesma."""

    __slots__ = ("x", "y", "vy", "chao", "coyote", "buffer", "cortou", "morto")
    W, H = 9.0, 7.0

    def __init__(self, x=20.0):
        self.x, self.y, self.vy = x, CHAO, 0.0
        self.chao, self.coyote, self.buffer, self.cortou, self.morto = True, 0.0, 0.0, False, None

    def copia(self):
        g = Gato.__new__(Gato)
        for k in Gato.__slots__:
            setattr(g, k, getattr(self, k))
        return g

    def passo(self, dt, fase, apertou, soltou, variavel):
        """Avança um passo. Devolve "pulou", "pousou", "morreu" ou None."""
        ev = None
        self.buffer = BUFFER if apertou else max(0.0, self.buffer - dt)
        self.coyote = COYOTE if self.chao else max(0.0, self.coyote - dt)
        if self.buffer > 0 and self.coyote > 0:
            self.vy, self.chao, self.coyote, self.buffer, self.cortou = PULO, False, 0.0, 0.0, False
            ev = "pulou"
        if variavel and soltou and self.vy < 0 and not self.cortou:
            self.vy *= 0.5
            self.cortou = True
        nx = self.x + vel_gato(self.x) * dt
        for bx, top, bw in fase.perto(fase.caixas, nx, nx + self.W):
            if nx + self.W - 1.2 > bx and nx + 1.2 < bx + bw and self.y > top:
                if self.y > top + 1.5:
                    self.morto = "bateu"
                    return "morreu"
                self.y = top  # degrau baixo: sobe em vez de bater
        self.x = nx
        g = G_SUB if self.vy < 0 else G_DESC
        self.vy = min(self.vy + g * dt, VY_MAX)
        ny = self.y + self.vy * dt
        topo = fase.apoio(self.x + 2, self.x + self.W - 2, self.y, ny) if self.vy >= 0 else None
        if topo is not None:
            if not self.chao:
                ev = "pousou"
            self.y, self.vy, self.chao = topo, 0.0, True
        else:
            self.y, self.chao = ny, False
        if self.y > CHAO + 4:
            self.morto = "caiu"
            return "morreu"
        return ev


class PuloDoGato(Jogo):
    nome, titulo, abertura = "gato", "Pulo do Gato", "gato"
    dicas = "espaço/↑ pula   p pausa   q sai"

    def iniciar(self, semente):
        super().iniciar(semente)
        self.fase = Fase(semente)
        self.gato = Gato()
        self.cam = Camera()
        self.part = Particulas(200)
        self.novelos = 0
        self.morreu_em = None
        self.squash = 0.0   # >0 achatado (pouso), <0 esticado (pulo)
        self.flash = 0.0
        self.passos = 0

    def metros(self):
        return int(self.gato.x / METRO)

    def pontos(self):
        return self.metros() + 25 * self.novelos

    def atualizar(self, dt, ent):
        super().atualizar(dt, ent)
        g = self.gato
        self.fase.garantir(g.x + 400)
        self.part.atualizar(dt)
        self.cam.atualizar(dt, self.rng)
        self.flash = max(0.0, self.flash - dt * 2.5)
        self.squash *= 0.8
        if self.morreu_em is not None:
            g.vy += G_DESC * dt
            g.y += g.vy * dt
            return "fim" if self.t - self.morreu_em > 1.6 else None
        variavel = ent.modo != "fallback"
        ev = g.passo(dt, self.fase, ent.apertou("pular"), ent.soltou("pular"), variavel)
        if ev == "pulou":
            self.squash = -1.0
            self.part.explodir(self.rng, g.x + 3, CHAO if g.y >= CHAO - 0.1 else g.y, 5, 14, 0.35,
                               [(230, 210, 170), (200, 180, 140)], grav=-10, tam=0.9, cone=(math.pi, 2 * math.pi))
        elif ev == "pousou":
            self.squash = 1.0
            for lado in (-1, 1):
                self.part.explodir(self.rng, g.x + 4.5 + lado * 3, g.y - 0.5, 4, 16, 0.4,
                                   [(230, 210, 170), (200, 180, 140)], grav=20, tam=0.9,
                                   cone=(math.pi * (1.1 if lado < 0 else 1.6), math.pi * (1.4 if lado < 0 else 1.9)))
        elif ev == "morreu":
            self.morreu_em = self.t
            g.vy = -90.0
            self.cam.tremer(1.2)
            self.flash = 1.0
            self.part.explodir(self.rng, g.x + 4.5, g.y - 3, 24, 40, 0.8,
                               [(255, 255, 255), (255, 200, 120), (240, 146, 62)], grav=60, tam=1.2)
        if g.chao and g.vy == 0 and int(self.t * 30) % 6 == 0:
            self.part.emitir(g.x + 1, g.y - 0.5, -10 - self.rng.random() * 8, -6, 0.3, (220, 200, 160), grav=20, tam=0.6)
        for x, y, pego in self.fase.perto(self.fase.novelos, g.x, g.x + g.W):
            if not pego[0] and colide((g.x, g.y - g.H, g.W, g.H), (x, y, 3.5, 3.5), folga=0.0):
                pego[0] = True
                self.novelos += 1
                self.part.explodir(self.rng, x + 1.7, y + 1.7, 10, 22, 0.5,
                                   [(255, 160, 200), (255, 255, 255), (255, 220, 120)], tam=0.8)
        return None

    def ceu(self):
        """Hora do dia pela distância: dia, pôr do sol, noite e aurora a cada 500 m."""
        ciclo = [CEU_DIA, CEU_POR, CEU_NOITE, CEU_AURORA]
        m = self.gato.x / METRO
        i = int(m // 500)
        p = max(0.0, (m % 500 - 460) / 40)
        p = round(p * 8) / 8  # poucos degraus de transição: o céu continua no cache
        a, b = ciclo[i % 4], ciclo[(i + 1) % 4]
        if p <= 0:
            return a, 1.0 if a is CEU_NOITE else 0.0
        pos = [0, 0.3, 0.6, 1]
        ceu = [(q, lerp_cor(cor_em(a, q), cor_em(b, q), p)) for q in pos]
        noite = (1 - p if a is CEU_NOITE else 0.0) + (p if b is CEU_NOITE else 0.0)
        return ceu, noite

    def desenhar(self, tela):
        cam, g = self.cam, self.gato
        cam.ajustar(tela)
        cam.x = g.x - 16 if self.morreu_em is None else cam.x
        e = cam.escala
        gy = cam.ty(CHAO)
        ceu, noite = self.ceu()
        off = cam.x * e
        colinas(tela, off, gy, ceu, noite)
        if noite > 0.3:
            tela.brilho(tela.W * 0.8, tela.H * 0.2, tela.H * 0.2, (200, 210, 255), 0.3 * noite)
            tela.circulo(tela.W * 0.8, tela.H * 0.2, max(2, tela.H * 0.06), lerp_cor((255, 250, 220), (235, 235, 220), noite))
        else:
            tela.brilho(tela.W * 0.82, tela.H * 0.16, tela.H * 0.25, (255, 250, 210), 0.5)
        x0, x1 = cam.x - 10, cam.x + cam.largura_visivel() + 10
        buracos = [(cam.tx(a), cam.tx(b)) for a, b in self.fase.perto(self.fase.buracos, x0, x1)]
        chao_tijolos(tela, gy, off, e, buracos)
        for px, py, pw in self.fase.perto(self.fase.plataformas, x0, x1):
            sx, sy, sw = cam.tx(px), cam.ty(py), cam.px(pw)
            tela.retangulo(sx, sy, sx + sw, sy + max(2, e * 2.2), (150, 92, 44))
            tela.retangulo(sx, sy, sx + sw, sy + max(1, e * 0.6), (200, 146, 80))
            tela.retangulo(sx, sy + max(2, e * 2.2) - 1, sx + sw, sy + max(2, e * 2.2), (80, 44, 20))
        for bx, top, bw in self.fase.perto(self.fase.caixas, x0, x1):
            alt = CHAO - top
            n = int(round(alt / 7)) if alt > 7.5 else 1
            for k in range(n):
                tela.desenhar(caixa(cam.px(bw), cam.px(alt / n)), cam.tx(bx), cam.ty(top + k * alt / n))
        hn = cam.px(3.5)
        for x, y, pego in self.fase.perto(self.fase.novelos, x0, x1):
            if not pego[0]:
                bob = math.sin(self.t * 4 + x) * e * 0.6
                tela.brilho(cam.tx(x) + hn / 2, cam.ty(y) + hn / 2 + bob, hn * 1.2, (255, 190, 220), 0.35)
                tela.desenhar(novelo(hn), cam.tx(x), cam.ty(y) + bob)
        self._desenhar_gato(tela)
        self.part.desenhar(tela, cam)
        self._hud(tela)
        if self.flash > 0:
            tela.flash(min(1.0, self.flash) * 0.8)

    def _desenhar_gato(self, tela):
        cam, g = self.cam, self.gato
        h = cam.px(10)
        if self.morreu_em is not None:
            spr = gato(h, 4, "normal", morto=True)
        else:
            forma = "achatado" if self.squash > 0.35 else "esticado" if self.squash < -0.35 or g.vy < -40 else "normal"
            spr = gato(h, int(self.t * 14) % 4 if g.chao else 4, forma)
        if g.y <= CHAO + 0.1 and not self.fase.no_buraco(g.x + 2, g.x + g.W - 2):
            alt = max(0.0, CHAO - g.y)
            tela.sombra(cam.tx(g.x + 4.5), cam.ty(CHAO) + 1, cam.px(4.5) / (1 + alt * 0.08), max(1, cam.px(0.8)))
        # o sprite (1,5h de largura) é centralizado na caixa de colisão (W de largura)
        tela.desenhar(spr, cam.tx(g.x + g.W / 2) - spr.w * 0.55, cam.ty(g.y) - spr.h + 1)

    def _hud(self, tela):
        s = 1 if tela.H < 90 else 2
        hud_texto(tela, f"{self.pontos():06d}", 2, 2, s, (255, 230, 140))
        hud_texto(tela, f"{self.metros()}M", 2, 3 + 6 * s, s, (255, 255, 255))
        larg = hud_texto(tela, f"{self.novelos:03d}", tela.W - 2, 2, s, (255, 200, 225), direita=True)
        tela.desenhar(novelo(5 * s), tela.W - 2 - larg - 7 * s, 2)
        if self.t < 4:
            tela.texto(tela.rows - 1, self.dicas, (255, 255, 255))


# ======================================================================== jogos: Tocha Eterna
PAREDE, PISO = 0, 1
DIRECOES = {"cima": (0, -1), "baixo": (0, 1), "esquerda": (-1, 0), "direita": (1, 0)}
INIMIGOS = {
    # tipo: (vida, dano, pontos)
    "gosma": (2, 1, 50),     # persegue
    "vulto": (1, 1, 80),     # foge da luz, ataca no escuro
    "pedrusco": (3, 1, 120),  # lento: só se mexe a cada dois turnos
}


class Andar:
    """Um andar da masmorra gerado por BSP: divide a área, põe uma sala em cada folha
    e liga as salas irmãs com corredores em L. A escada fica na sala mais longe da entrada."""

    def __init__(self, semente, numero, largura=40, altura=28):
        self.rng = random.Random(semente * 1009 + numero)
        self.numero, self.W, self.H = numero, largura, altura
        self.grade = [[PAREDE] * largura for _ in range(altura)]
        self.salas = []
        self._dividir(1, 1, largura - 2, altura - 2, 0)
        self.entrada = self._centro(self.salas[0])
        dist = self.distancias(self.entrada)
        self.escada = max(((x, y) for x, y in dist if self._em_sala(x, y)), key=lambda p: (dist[p], p))
        self.itens, self.inimigos = {}, []
        self._povoar(dist)

    def _dividir(self, x, y, w, h, nivel):
        r = self.rng
        if (w < 16 and h < 12) or nivel > 4:
            rw = r.randint(4, max(4, min(w - 2, 10)))
            rh = r.randint(3, max(3, min(h - 2, 7)))
            rx, ry = x + r.randint(1, max(1, w - rw - 1)), y + r.randint(1, max(1, h - rh - 1))
            sala = (rx, ry, rw, rh)
            for yy in range(ry, ry + rh):
                for xx in range(rx, rx + rw):
                    self.grade[yy][xx] = PISO
            self.salas.append(sala)
            return [sala]
        if w / h > 1.25 or (h / w <= 1.25 and r.random() < 0.5 and w >= 16):
            corte = r.randint(int(w * 0.38), int(w * 0.62))
            a = self._dividir(x, y, corte, h, nivel + 1)
            b = self._dividir(x + corte, y, w - corte, h, nivel + 1)
        else:
            corte = r.randint(int(h * 0.38), int(h * 0.62))
            a = self._dividir(x, y, w, corte, nivel + 1)
            b = self._dividir(x, y + corte, w, h - corte, nivel + 1)
        self._corredor(self._centro(r.choice(a)), self._centro(r.choice(b)))
        return a + b

    @staticmethod
    def _centro(sala):
        x, y, w, h = sala
        return (x + w // 2, y + h // 2)

    def _em_sala(self, x, y):
        return any(sx <= x < sx + sw and sy <= y < sy + sh for sx, sy, sw, sh in self.salas)

    def _corredor(self, a, b):
        (x0, y0), (x1, y1) = a, b
        if self.rng.random() < 0.5:
            x0, y0, x1, y1 = x1, y1, x0, y0
        for x in range(min(x0, x1), max(x0, x1) + 1):
            self.grade[y0][x] = PISO
        for y in range(min(y0, y1), max(y0, y1) + 1):
            self.grade[y][x1] = PISO

    def livre(self, x, y):
        return 0 <= x < self.W and 0 <= y < self.H and self.grade[y][x] == PISO

    def distancias(self, origem):
        """Distância em passos (BFS) de origem até cada piso alcançável."""
        dist, fila = {origem: 0}, [origem]
        for x, y in fila:
            for dx, dy in DIRECOES.values():
                p = (x + dx, y + dy)
                if p not in dist and self.livre(*p):
                    dist[p] = dist[(x, y)] + 1
                    fila.append(p)
        return dist

    def _povoar(self, dist):
        r, n = self.rng, self.numero
        longe = sorted(p for p, d in dist.items() if d >= 5 and p != self.escada)
        r.shuffle(longe)
        for tipo, qtd in (("oleo", 3), ("cristal", 3 + n // 2), ("coracao", 1)):
            for _ in range(qtd):
                if longe:
                    self.itens[longe.pop()] = tipo
        tipos = ["gosma"] * 3 + ["vulto"] * (2 if n >= 2 else 0) + ["pedrusco"] * (2 if n >= 3 else 1)
        for _ in range(min(len(longe), 2 + n)):
            x, y = longe.pop()
            tipo = r.choice(tipos)
            self.inimigos.append(Criatura(tipo, x, y, INIMIGOS[tipo][0]))

    def visiveis(self, origem, raio):
        """Campo de visão: raycast de Bresenham até cada célula dentro do raio."""
        ox, oy = origem
        vis = {origem}
        R = int(math.ceil(raio))
        for y in range(oy - R, oy + R + 1):
            for x in range(ox - R, ox + R + 1):
                if (x - ox) ** 2 + (y - oy) ** 2 > raio * raio or not (0 <= x < self.W and 0 <= y < self.H):
                    continue
                if self._linha_livre(ox, oy, x, y):
                    vis.add((x, y))
        return vis

    def _linha_livre(self, x0, y0, x1, y1):
        dx, dy = abs(x1 - x0), -abs(y1 - y0)
        sx, sy = (1 if x1 > x0 else -1), (1 if y1 > y0 else -1)
        erro = dx + dy
        x, y = x0, y0
        while (x, y) != (x1, y1):
            if (x, y) != (x0, y0) and self.grade[y][x] == PAREDE:
                return False
            e2 = 2 * erro
            if e2 >= dy:
                erro += dy
                x += sx
            if e2 <= dx:
                erro += dx
                y += sy
        return True


class Criatura:
    __slots__ = ("tipo", "x", "y", "vida", "ax", "ay", "t_mov", "turnos", "t_dano")

    def __init__(self, tipo, x, y, vida):
        self.tipo, self.x, self.y, self.vida = tipo, x, y, vida
        self.ax, self.ay, self.t_mov, self.turnos, self.t_dano = x, y, -1.0, 0, -1.0

    def mover(self, x, y, agora):
        self.ax, self.ay = self.x, self.y
        self.x, self.y, self.t_mov = x, y, agora

    def pos_desenho(self, agora, dur=0.1):
        """Posição interpolada entre o turno anterior e o atual: nada de teletransporte."""
        q = ease(min(1.0, (agora - self.t_mov) / dur))
        return lerp(self.ax, self.x, q), lerp(self.ay, self.y, q)


