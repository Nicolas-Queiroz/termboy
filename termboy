def castelo(tela, cx, base, u, cor, t):
    janela = (255, 190, 90)
    tela.retangulo(cx - 3.6 * u, base - 4.5 * u, cx + 3.6 * u, base + 1, cor)
    for k in range(-7, 8, 2):
        tela.retangulo(cx + k * u * 0.5 - u * 0.2, base - 5.1 * u, cx + k * u * 0.5 + u * 0.2, base - 4.5 * u, cor)
    for pos, alt, larg in ((-3.0, 7, 1.6), (-1.5, 9.5, 1.5), (0.0, 12, 2.0), (1.5, 9, 1.5), (3.0, 6.5, 1.6)):
        x0, x1 = cx + pos * u - larg * u / 2, cx + pos * u + larg * u / 2
        tela.retangulo(x0, base - alt * u, x1, base + 1, cor)
        tela.poligono([(x0 - u * 0.2, base - alt * u), (x1 + u * 0.2, base - alt * u),
                       ((x0 + x1) / 2, base - alt * u - larg * u * 1.4)], cor)
