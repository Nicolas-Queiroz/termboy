@functools.lru_cache(maxsize=64)
def carro(w, cor):
    """Carro esportivo visto de trás."""
    w = max(6, int(w))
    h = max(4, int(w * 0.5))
    s = Spr(w, h)
    rampa = [escurecer(cor, 0.45), escurecer(cor, 0.2), cor, clarear(cor, 0.3)]
    for fx in (0.06, 0.74):
        s.ret(w * fx, h * 0.62, w * (fx + 0.2), h, (22, 22, 28))
        s.ret(w * fx, h * 0.66, w * (fx + 0.2), h * 0.66 + 1, (60, 60, 70))
    s.poligono([(w * 0.02, h * 0.45), (w * 0.98, h * 0.45), (w * 0.96, h * 0.86), (w * 0.04, h * 0.86)], rampa, "vert")
    s.poligono([(w * 0.22, h * 0.1), (w * 0.78, h * 0.1), (w * 0.9, h * 0.47), (w * 0.1, h * 0.47)], rampa, "vert")
    s.poligono([(w * 0.27, h * 0.16), (w * 0.73, h * 0.16), (w * 0.82, h * 0.42), (w * 0.18, h * 0.42)],
               [(25, 32, 60), (45, 62, 105), (80, 108, 160), (150, 180, 220)], "vert")
    s.ret(0, h * 0.28, w, h * 0.35, escurecer(cor, 0.55))
    s.ret(w * 0.12, h * 0.35, w * 0.16, h * 0.45, escurecer(cor, 0.55))
    s.ret(w * 0.84, h * 0.35, w * 0.88, h * 0.45, escurecer(cor, 0.55))
    s.contorno((18, 10, 16))
    for fx in (0.07, 0.73):
        s.ret(w * fx, h * 0.52, w * (fx + 0.2), h * 0.62, (255, 50, 50))
        s.ret(w * fx, h * 0.52, w * (fx + 0.2), h * 0.52 + 1, (255, 170, 160))
    s.ret(w * 0.4, h * 0.6, w * 0.6, h * 0.72, (230, 228, 205))
    return s


PREDIOS = [(RNG.random(), 0.03 + RNG.random() * 0.05, 0.2 + RNG.random() * 0.8, RNG.randint(0, 999)) for _ in range(28)]
CEU_CORRIDA = [(0, (28, 18, 78)), (0.45, (190, 64, 112)), (0.8, (255, 146, 80)), (1, (255, 222, 140))]


def turbo_posicao(t):
    pos, v, passo, x = 0.0, 0.0, 0.05, 3.0
    while x < t:
        if x < 5.0:
            v = 6 * ease((x - 3.0) / 2.0)
        elif 8.0 <= x < 10.5:
            v = 6 + 5 * ease((x - 8.0) / 0.6)
        else:
            v = 6
        pos += v * passo
        x += passo
    return pos


def turbo_pista(tela, pos, curva, hz):
    W, H = tela.W, tela.H
    tela.ceu(CEU_CORRIDA, y1=hz + 1)
    sx = W * 0.5 - curva * W * 0.25
    r = max(3, H * 0.17)
    tela.brilho(sx, hz, r * 2.6, (255, 190, 120), 0.55)
    for y in range(int(hz - r), hz + 1):
        if y > hz - r * 0.55 and y % 3 == 0:
            continue
        for x in range(int(sx - r), int(sx + r) + 1):
            if (x + 0.5 - sx) ** 2 + (y + 0.5 - hz) ** 2 <= r * r:
                tela.ponto(x, y, lerp_cor((255, 236, 120), (255, 110, 90), (y - (hz - r)) / r))
    largura = W * 1.6
    c_pred, c_jan = (38, 22, 66), (255, 205, 120)
    for fx, fw, fh, sem in PREDIOS:
        bx = (fx * largura - curva * W * 0.35) % largura - W * 0.3
        bw, bh = max(2, fw * W), fh * H * 0.22
        tela.retangulo(bx, hz - bh, bx + bw, hz + 1, c_pred)
        for yy in range(int(hz - bh) + 1, hz - 1, 2):
            for xx in range(int(bx) + 1, int(bx + bw) - 1, 2):
                if _hash(xx + sem, yy) > 0.62:
                    tela.ponto(xx, yy, c_jan)
    cores = {k: tela.c(v) for k, v in {
        "g1": (72, 170, 72), "g2": (58, 148, 58), "a1": (104, 104, 116), "a2": (94, 94, 106),
        "z1": (236, 236, 236), "z2": (214, 42, 42), "faixa": (245, 245, 245)}.items()}
    for y in range(hz + 1, H):
        p = (y - hz) / max(1, H - hz)
        z = 1 / max(p, 0.02)
        meia = W * 0.03 + p * W * 0.5
        cx = W / 2 + curva * W * 0.7 * (1 - p) ** 2
        fase = int(z * 2.2 + pos) % 2
        g, a, zb = (cores["g1"], cores["a1"], cores["z1"]) if fase else (cores["g2"], cores["a2"], cores["z2"])
        linha = tela.px[y]
        for x in range(W):
            d = abs(x + 0.5 - cx)
            if d < meia * 0.035 and fase:
                linha[x] = cores["faixa"]
            elif d < meia:
                linha[x] = a
            elif d < meia * 1.13:
                linha[x] = zb
            else:
                linha[x] = g


def turbo(tela, t):
    W, H = tela.W, tela.H
    hz = int(H * 0.42)
    cw = int(min(W * 0.3, H * 0.75))
    if t < 11.0:
        pos = turbo_posicao(t) if t > 3 else 0.0
        curva = math.sin((t - 3) * 0.45) * 0.8 if t > 3 else 0.0
        turbo_pista(tela, pos, curva, hz)
        cx_carro = W / 2 + curva * W * 0.04 + (math.sin(t * 9) * 0.5 if t > 3 else 0)
        y_carro = H - int(cw * 0.5) - 1 + (int(t * 12) % 2 if t > 3 else 0)
        if 5.0 <= t < 8.5:
            q = ((t - 5.0) / 3.5) ** 1.6
            p = lerp(0.1, 1.25, q)
            ycar = hz + p * (H - hz)
            meia = W * 0.03 + p * W * 0.5
            cxr = W / 2 + curva * W * 0.7 * (1 - min(p, 1)) ** 2 - meia * 0.5
            wr = max(6, cw * p)
            if p < 1.0:
                tela.desenhar(carro(int(wr), (40, 96, 220)), cxr - wr / 2, ycar - wr * 0.5)
        tela.sombra(cx_carro, H - 1, cw * 0.5, max(1, cw * 0.06), 0.4)
        tela.desenhar(carro(cw, (220, 36, 48)), cx_carro - cw / 2, y_carro)
        for fx in (0.17, 0.83):
            tela.brilho(cx_carro - cw / 2 + cw * fx, y_carro + cw * 0.28, cw * 0.12, (255, 60, 60), 0.5)
        if 8.0 <= t < 10.5:
            for k in range(2):
                fl = cw * (0.12 + 0.06 * math.sin(t * 40 + k))
                bx = cx_carro + (k - 0.5) * cw * 0.3
                by = y_carro + cw * 0.46
                tela.brilho(bx, by, fl * 1.6, (120, 170, 255), 0.9)
                tela.brilho(bx, by, fl * 0.7, (255, 255, 255), 0.9)
            for k in range(24):
                ang = k * 2 * math.pi / 24 + _hash(k, 3) * 0.3
                fase = (t * 2.5 + _hash(k, 9)) % 1
                r1, r2 = lerp(0.2, 1.3, fase) * W, lerp(0.3, 1.5, fase) * W
                if math.sin(ang) > -0.2:
                    tela.linha(W / 2 + math.cos(ang) * r1 * 0.5, hz + math.sin(ang) * r1 * 0.3,
                               W / 2 + math.cos(ang) * r2 * 0.5, hz + math.sin(ang) * r2 * 0.3, (255, 255, 255), 0.5)
        if t < 3.0:
            tela.flash(0.35, (0, 0, 0))
            lw, lh = W * 0.22, H * 0.14
            lx, ly = W / 2 - lw / 2, H * 0.05
            tela.retangulo(lx, ly, lx + lw, ly + lh, (25, 25, 32))
            tela.retangulo(lx, ly, lx + lw, ly + 1, (90, 90, 100))
            acesas = 0 if t < 0.7 else 1 if t < 1.4 else 2 if t < 2.1 else 3
            for i in range(3):
                bx, by, br = lx + lw * (0.2 + 0.3 * i), ly + lh / 2, max(1.2, lh * 0.32)
                verde = t >= 2.7
                cor = (60, 255, 90) if verde else (255, 40, 40) if i < acesas else (70, 20, 20)
                if verde or i < acesas:
                    tela.brilho(bx, by, br * 3, cor, 0.6)
                tela.circulo(bx, by, br, cor)
            num = "GO!" if t >= 2.7 else str(3 - acesas + 1) if acesas else ""
            if num and acesas:
                s = max(1, int(H * 0.06))
                larg = (len(num) * 6 - 1) * s
                for n, ch in enumerate(num):
                    x, y = W / 2 - larg / 2 + n * 6 * s, H * 0.24
                    tela.letra(ch, x + s, y + s, s, (40, 10, 10))
                    tela.letra(ch, x, y, s, (255, 240, 120) if num != "GO!" else (120, 255, 140))
        if t >= 10.4:
            tela.flash((t - 10.4) / 0.6)
        return

    # tela de título: horizonte neon
    hz2 = int(H * 0.56)
    tela.ceu([(0, (14, 4, 40)), (0.7, (110, 20, 120)), (1, (255, 90, 150))], y1=hz2)
    estrelas(tela, t, 0.35)
    sx, r = W / 2, max(3, H * 0.2)
    for y in range(int(hz2 - r), hz2):
        if y > hz2 - r * 0.6 and y % 3 == 0:
            continue
        for x in range(int(sx - r), int(sx + r) + 1):
            if (x + 0.5 - sx) ** 2 + (y + 0.5 - hz2) ** 2 <= r * r:
                tela.ponto(x, y, lerp_cor((255, 230, 90), (255, 60, 140), (y - (hz2 - r)) / r))
    tela.retangulo(0, hz2, W, H, (16, 4, 34))
    neon = (255, 70, 210)
    for y in range(hz2, H):
        p = (y - hz2 + 0.5) / max(1, H - hz2)
        z0, z1 = 1 / (p + 0.04), 1 / (p + 1 / max(1, H - hz2) + 0.04)
        if int(z0 * 1.2 + t * 3) != int(z1 * 1.2 + t * 3):
            tela.retangulo(0, y, W, y + 1, lerp_cor((90, 20, 110), neon, p + 0.3))
        for k in range(-14, 15):
            x = W / 2 + k * W * 0.11 * (0.06 + p * 1.4)
            tela.ponto(x, y, lerp_cor((90, 20, 110), neon, p + 0.3))
    tela.brilho(W / 2, hz2, W * 0.5, (255, 90, 200), 0.25)
    if t < 11.4:
        tela.flash(1 - (t - 11.0) / 0.4)
    fim = titulo(tela, ["TURBO", "ASFALTO"], t, 11.2,
                 [(255, 255, 255), (170, 210, 255), (50, 80, 170), (255, 150, 60), (255, 230, 140)],
                 contorno=(10, 8, 40), sombra=(60, 10, 70), entrada="deslizar", inclinacao=0.35)
    if t >= 12.4:
