@functools.lru_cache(maxsize=4)
def nebulosa(W, H):
    campo = []
    for y in range(H):
        linha = []
        for x in range(W * 2):
            n = fbm(x * 0.045, y * 0.09, 3)
            m = ruido(x * 0.02 + 40, y * 0.04)
            a = max(0.0, (n - 0.42) * 1.6)
            linha.append((lerp_cor((150, 40, 170), (40, 150, 190), m), min(0.75, a)))
        campo.append(linha)
    return campo


def espaco(tela, t, vel):
    tela.ceu([(0, (2, 2, 12)), (1, (12, 6, 34))])
    neb = nebulosa(tela.W, tela.H)
    off = int(t * vel * 0.15)
    larg = tela.W * 2
    estilo = tela.estilo
    for y in range(tela.H):
        linha, px = neb[y], tela.px[y]
        for x in range(tela.W):
            c, a = linha[(x + off) % larg]
            if a > 0.02:
                px[x] = conv(lerp_cor(px[x], c, a), estilo)
    estrelas(tela, t, vel=vel)


def planeta(tela, cx, cy, r):
    tela.brilho(cx, cy, r * 1.4, (90, 200, 255), 0.35)
    ramp = [(14, 40, 60), (24, 80, 110), (40, 130, 160), (90, 190, 210), (170, 235, 245)]
    for y in range(int(cy - r), int(cy + r) + 1):
        for x in range(int(cx - r), int(cx + r) + 1):
            nx, ny = (x + 0.5 - cx) / r, (y + 0.5 - cy) / r
            r2 = nx * nx + ny * ny
            if r2 > 1:
                continue
            nz = math.sqrt(1 - r2)
            d = max(0.0, min(0.999, nx * LUZ[0] + ny * LUZ[1] + nz * LUZ[2]))
            faixa = 0.12 * math.sin(ny * 14 + ruido(x * 0.1, y * 0.3) * 3)
            tela.ponto(x, y, ramp[max(0, min(4, int((d + faixa) * 5)))])
    for k in range(int(r * 7)):
        a = k / (r * 7) * 2 * math.pi
        x, y = cx + math.cos(a) * r * 1.7, cy + math.sin(a) * r * 0.35
        if math.sin(a) > 0 or (x - cx) ** 2 / r ** 2 + (y - cy) ** 2 / r ** 2 > 1:
            tela.ponto(x, y, (240, 180, 110) if k % 3 else (200, 130, 80))


def explosao(tela, x, y, q, tam):
    if not 0 <= q < 1:
        return
    tela.brilho(x, y, tam * (0.6 + q), (255, 220, 140), 1 - q)
    for k in range(10):
        ang = k * 2 * math.pi / 10 + _hash(k, int(x)) * 0.5
        d = q * tam * (1 + _hash(k, 5))
        tela.brilho(x + math.cos(ang) * d, y + math.sin(ang) * d, max(1.2, tam * 0.2),
                    (255, 140, 40) if k % 2 else (255, 255, 200), 1 - q)


def astro(tela, t):
    W, H = tela.W, tela.H
    hn = int(min(H * 0.22, W * 0.1))
    if t < 3.0:
        espaco(tela, t, 6)
        planeta(tela, W * 0.72, H * 0.62, max(3, H * 0.28))
        if 0.6 <= t <= 2.8:
            a = min(1, (t - 0.6) / 0.4, (2.8 - t) / 0.4)
            tela.texto(tela.rows // 4, "ANO 2189 - SETOR VÉRTICE", lerp_cor((8, 4, 24), (190, 230, 255), a))
        return
    if t < 11.0:
        espaco(tela, t, 14)
        planeta(tela, W * 0.72 - (t - 3) * 2, H * 0.62, max(3, H * 0.28))
        tremor = (_hash(int(t * 30), 1) - 0.5) * hn * 0.4 if t >= 10.0 else 0
        nx = lerp(-hn * 2, W * 0.12, ease((t - 3.0) / 1.2))
        ny = H * 0.45 + math.sin(t * 2.2) * H * 0.12
        for k in range(1, 7):
            tela.brilho(nx - k * hn * 0.35, ny + hn * 0.5, hn * 0.3 * (1 - k / 7), (255, 160, 60), 0.6)
        tela.brilho(nx, ny + hn * 0.5, hn * (0.35 + 0.08 * math.sin(t * 30)), (120, 200, 255), 0.9)
        tela.desenhar(nave(hn), nx + tremor, ny - tremor)
        hd = max(5, int(hn * 1.1))
        for k in range(6):
            ts = 4.0 + k * 0.55
            th = ts + 1.6
            if t < ts or t >= th + 0.8:
                continue
            ex = W + hd - (t - ts) * W * 0.32
            ey = H * 0.48 + math.sin((t - ts) * 2.5 + k) * H * 0.26
            if t < th:
                tela.desenhar(drone(hd), ex - hd / 2, ey - hd / 2)
            else:
                ex2 = W + hd - (th - ts) * W * 0.32
                ey2 = H * 0.48 + math.sin((th - ts) * 2.5 + k) * H * 0.26
                explosao(tela, ex2, ey2, (t - th) / 0.8, hd)
        if 4.4 <= t < 9.6:
            for k in range(16):
                tf = 4.4 + k * 0.32
                if tf > t:
                    break
                bx = nx + hn * 1.8 + (t - tf) * W * 1.1
                by = H * 0.45 + math.sin(tf * 2.2) * H * 0.12 + hn * 0.52
                if bx < W:
                    tela.retangulo(bx, by, bx + max(2, hn * 0.5), by + 1, (255, 250, 150))
                    tela.brilho(bx + hn * 0.25, by, hn * 0.25, (255, 230, 80), 0.4)
        if 6.0 <= t < 8.5:
            ax = lerp(W + H * 0.3, -H * 0.4, (t - 6.0) / 2.5)
            ar = H * 0.22
            ramp = [(30, 26, 26), (60, 52, 48), (95, 84, 76), (140, 126, 112)]
            for y in range(int(H * 0.8 - ar), int(H * 0.8 + ar) + 1):
                for x in range(int(ax - ar), int(ax + ar) + 1):
                    nx2, ny2 = (x + 0.5 - ax) / ar, (y + 0.5 - H * 0.8) / ar
                    r2 = nx2 * nx2 + ny2 * ny2
                    borda = 0.75 + 0.25 * ruido(math.atan2(ny2, nx2) * 3 + 10, 2)
                    if r2 <= borda * borda:
                        d = nx2 * LUZ[0] + ny2 * LUZ[1] + math.sqrt(max(0, 1 - r2)) * LUZ[2]
                        d += (ruido(x * 0.3, y * 0.3) - 0.5) * 0.4
                        tela.ponto(x, y, ramp[max(0, min(3, int(d * 4)))])
        if t >= 8.8:
            hb = int(H * 0.85)
            bx = lerp(W + 2, W - hb * 0.95, ease((t - 9.2) / 1.2)) + tremor
            by = H * 0.08
            spr = colosso(hb)
            tela.desenhar(spr, bx, by)
            for fx in (0.36, 0.6):
                ox, oy = bx + spr.w * fx, by + hb * 0.42
                tela.brilho(ox, oy, hb * 0.12, (255, 40, 40), 0.9)
                tela.circulo(ox, oy, max(0.8, hb * 0.03), (255, 230, 200))
            if t < 10.4 and int(t * 4) % 2 == 0:
                tela.texto(1, "!! ALERTA !!", (255, 60, 60))
        if t >= 10.4:
            tela.flash((t - 10.4) / 0.6)
        return

    espaco(tela, t, 3)
    planeta(tela, W * 0.8, H * 0.78, max(3, H * 0.3))
    if t < 11.4:
        tela.flash(1 - (t - 11.0) / 0.4)
    fim = titulo(tela, ["ASTRO", "VERTICE"], t, 11.2,
                 [(220, 255, 255), (80, 220, 255), (40, 100, 220), (140, 60, 200)],
                 contorno=(6, 8, 30), sombra=(30, 10, 60), entrada="revelar")
    if 12.2 <= t < 14.0:
        q = (t - 12.2) / 1.8
        nx, ny = lerp(-hn * 2, W + hn, q), lerp(H * 0.9, fim + (H - fim) * 0.3, q)
        for k in range(1, 10):
            tela.brilho(nx - k * hn * 0.5, ny + hn * 0.5 + k * 0.6, hn * 0.3 * (1 - k / 10), (120, 200, 255), 0.5)
        tela.desenhar(nave(hn), nx, ny)
    rodape(tela, t, 13.0, "MISSÃO ÓRBITA ZERO", fim // 2 + 1, 13.8)

