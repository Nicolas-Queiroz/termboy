@functools.lru_cache(maxsize=32)
def girar(fabrica, h, *args):
    """Sprite girado 90° no sentido anti-horário: o que apontava para a direita aponta para cima."""
    spr = fabrica(h, *args)
    s = Spr(spr.h, spr.w)
    s.px = {(y, spr.w - 1 - x): c for (x, y), c in spr.px.items()}
    return s


@functools.lru_cache(maxsize=16)
def rocha(h):
    h = max(4, int(h))
    s = Spr(h, h)
    rampa = [(40, 34, 34), (72, 64, 60), (110, 100, 92), (150, 138, 124)]
    pts = []
    for k in range(9):
        a = k / 9 * 2 * math.pi
        r = h * 0.45 * (0.78 + 0.22 * _hash(k, h))
        pts.append((h / 2 + math.cos(a) * r, h / 2 + math.sin(a) * r))
    s.poligono(pts, rampa)
    s.contorno((20, 16, 16))
    for k in range(3):
        s.px[(int(h * (0.3 + 0.2 * k)), int(h * (0.4 + 0.15 * (k % 2))))] = (50, 44, 42)
    return s


class AstroVertice(Jogo):
    """Shmup vertical em 5 colunas: a nave pula de coluna em coluna e atira para cima."""

    nome, titulo, abertura = "astro", "Astro Vértice", "astro"
    dicas = "←/→ muda de coluna   espaço atira   p pausa   q sai"
    COLUNAS = 5
    Y_NAVE = 0.86
    ESCUDO = 3

    def iniciar(self, semente):
        super().iniciar(semente)
        self.col, self.col_vis = 2, 2.0
        self.escudo = self.ESCUDO
        self.tiros, self.inimigos, self.disparos = [], [], []  # tiros: [col, y]; inimigos: [tipo, col, y, vida]
        self.explosoes = []  # [col, y, t0, tam]
        self.recarga, self.proxima, self.abatidos = 0.0, 1.0, 0
        self.t_dano, self.morreu_em = -9.0, None
        self.cam = Camera()

    def pontos(self):
        return 100 * self.abatidos + int(self.t * 5)

    def velocidade(self):
        return min(0.42, 0.16 + self.t * 0.004)

    def atualizar(self, dt, ent):
        super().atualizar(dt, ent)
        self.cam.atualizar(dt, self.rng)
        self.explosoes = [e for e in self.explosoes if self.t - e[2] < 0.8]
        if self.morreu_em is not None:
            return "fim" if self.t - self.morreu_em > 1.8 else None
        if ent.apertou("esquerda"):
            self.col = max(0, self.col - 1)
        if ent.apertou("direita"):
            self.col = min(self.COLUNAS - 1, self.col + 1)
        self.col_vis += max(-dt * 12, min(dt * 12, self.col - self.col_vis))
        self.recarga = max(0.0, self.recarga - dt)
        if ent.apertou("acao", repetir=True) and self.recarga == 0:
            self.tiros.append([self.col, self.Y_NAVE - 0.06])
            self.recarga = 0.2
        self.proxima -= dt
        if self.proxima <= 0:
            self._onda()
        v = self.velocidade()
        for t in self.tiros:
            t[1] -= 1.6 * dt
        for d in self.disparos:
            d[1] += (v + 0.35) * dt
        for e in self.inimigos:
            e[2] += v * dt * (0.7 if e[0] == "rocha" else 1.0)
            if e[0] == "drone" and 0.1 < e[2] < 0.6 and self.rng.random() < dt * 0.25 * min(2, 1 + self.t / 60):
                self.disparos.append([e[1], e[2] + 0.05])
        for t in list(self.tiros):
            alvo = max((e for e in self.inimigos if e[1] == t[0] and e[2] < t[1] + 0.04 and e[2] > -0.05),
                       key=lambda e: e[2], default=None)
            if alvo and t[1] - alvo[2] < 0.08:
                self.tiros.remove(t)
                if alvo[0] == "drone":
                    self.inimigos.remove(alvo)
                    self.abatidos += 1
                    self.explosoes.append([alvo[1], alvo[2], self.t, 1.0])
                else:
                    self.explosoes.append([t[0], alvo[2] + 0.04, self.t, 0.3])
        self.tiros = [t for t in self.tiros if t[1] > -0.1]
        for e in list(self.inimigos):
            if e[1] == self.col and abs(e[2] - self.Y_NAVE) < 0.06 and abs(self.col_vis - self.col) < 0.5:
                self.inimigos.remove(e)
                self.explosoes.append([e[1], e[2], self.t, 1.0])
                self._dano()
        for d in list(self.disparos):
            if d[0] == self.col and abs(d[1] - self.Y_NAVE) < 0.04 and abs(self.col_vis - self.col) < 0.5:
                self.disparos.remove(d)
                self._dano()
        self.inimigos = [e for e in self.inimigos if e[2] < 1.15]
        self.disparos = [d for d in self.disparos if d[1] < 1.1]
        return None

    def _onda(self):
        """Uma fileira de inimigos em colunas distintas: no máximo 3 por fileira e 2 rochas
        (indestrutíveis), então sobram sempre duas colunas livres para fugir."""
        r = self.rng
        cols = list(range(self.COLUNAS))
        r.shuffle(cols)
        n = r.randint(1, min(3, 1 + int(self.t / 25)))
        for k in range(n):
            tipo = "rocha" if k < 2 and r.random() < 0.3 else "drone"
            self.inimigos.append([tipo, cols[k], -0.08, 1])
        self.proxima = r.uniform(0.7, 1.3) * max(0.55, 1.2 - self.t * 0.006)

    def _dano(self):
        self.escudo -= 1
        self.t_dano = self.t
        self.cam.tremer(1.0)
        if self.escudo <= 0:
            self.morreu_em = self.t
            self.explosoes.append([self.col, self.Y_NAVE, self.t, 2.0])

    def desenhar(self, tela):
        W, H = tela.W, tela.H
        self.cam.ajustar(tela)
        espaco_vertical(tela, self.t, 20)
        cw = min(W / self.COLUNAS, H * 0.3)
        X = lambda c: W / 2 + (c - (self.COLUNAS - 1) / 2) * cw
        dx = self.cam.dx * cw * 0.3
        for c in range(self.COLUNAS + 1):
            x = X(c - 0.5)
            for y in range(0, H, 3):
                tela.misturar(x, y + (int(self.t * 30) % 3), (80, 120, 200), 0.15)
        hd = max(5, int(cw * 0.6))
        for tipo, c, y, _ in self.inimigos:
            spr = drone(hd) if tipo == "drone" else rocha(int(hd * 1.1))
            tela.desenhar(spr, X(c) - spr.w / 2 + dx, y * H - spr.h / 2)
        for c, y in self.disparos:
            tela.brilho(X(c) + dx, y * H, max(1.5, cw * 0.08), (255, 60, 80), 0.9)
            tela.retangulo(X(c) - 0.5 + dx, y * H - 2, X(c) + 1 + dx, y * H + 1, (255, 200, 200))
        for c, y in self.tiros:
            tela.retangulo(X(c) + dx, y * H - max(2, hd * 0.4), X(c) + 1 + dx, y * H, (255, 250, 150))
            tela.brilho(X(c) + dx, y * H, max(1.2, cw * 0.06), (255, 230, 80), 0.5)
        for c, y, t0, tam in self.explosoes:
            explosao(tela, X(c) + dx, y * H, (self.t - t0) / 0.8, hd * tam)
        if self.morreu_em is None:
            hn = max(5, int(cw * 0.5))
            spr = girar(nave, hn)
            nx, ny = X(self.col_vis) - spr.w / 2 + dx, self.Y_NAVE * H - spr.h / 2
            tela.brilho(nx + spr.w / 2, ny + spr.h, hn * (0.5 + 0.1 * math.sin(self.t * 30)), (120, 200, 255), 0.9)
            pisca = self.t - self.t_dano < 1.0 and int(self.t * 12) % 2 == 0
            tela.desenhar(spr, nx, ny, (255, 80, 80) if pisca else None)
        s = 1 if H < 90 else 2
        hud_texto(tela, f"{self.pontos():06d}", 2, 2, s, (255, 230, 140))
        for k in range(self.ESCUDO):
            cor = (120, 220, 255) if k < self.escudo else (40, 50, 70)
            tela.retangulo(W - 4 - k * 5 * s - 3 * s, 2, W - 4 - k * 5 * s, 2 + 5 * s, cor)
        if self.t < 4:
            tela.texto(tela.rows - 1, self.dicas, (255, 255, 255))


def espaco_vertical(tela, t, vel):
    """Como espaco(), mas rolando de cima para baixo."""
    tela.ceu([(0, (2, 2, 12)), (1, (12, 6, 34))])
    neb = nebulosa(tela.H, tela.W)  # transposta: W linhas de 2H colunas
    off = int(t * vel * 0.15)
    larg = tela.H * 2
    estilo = tela.estilo
    for x in range(tela.W):
        coluna = neb[x]
        for y in range(tela.H):
            i = (y - off) % (2 * larg)
            c, a = coluna[i if i < larg else 2 * larg - 1 - i]  # espelhado: sem emenda ao dar a volta
            if a > 0.02:
                px = tela.px[y]
                px[x] = conv(lerp_cor(px[x], c, a), estilo)
    for fx, fy, fase, prof in ESTRELAS:
        y = (fy * tela.H + t * vel * (0.3 + prof)) % tela.H
        b = 0.5 + 0.5 * math.sin(t * 3 + fase)
        tela.ponto(fx * tela.W, y, lerp_cor((70, 70, 130), (255, 255, 235), b * (0.4 + 0.6 * prof)))


