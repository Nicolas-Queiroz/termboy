MUNDO_H = 48      # altura do mundo em unidades; o chão dos jogos de plataforma fica a 80%
MUNDO_W_MIN = 64  # largura mínima visível, para terminais estreitos não esconderem o que vem
TAM_MIN = (80, 24)


class Camera:
    """Converte coordenadas do mundo (altura fixa MUNDO_H) para pixels da tela.

    O tamanho do terminal muda a escala e quanto se vê à frente, nunca a física."""

    def __init__(self, x=0.0, y=0.0):
        self.x, self.y = x, y
        self.tremor = 0.0
        self.dx = self.dy = 0.0
        self.escala = 1.0
        self.W = self.H = 0

    def ajustar(self, tela):
        self.W, self.H = tela.W, tela.H
        self.escala = min(tela.H / MUNDO_H, tela.W / MUNDO_W_MIN)

    def largura_visivel(self):
        return self.W / self.escala

    def tremer(self, forca):
        self.tremor = max(self.tremor, forca)

    def atualizar(self, dt, rng):
        self.tremor = max(0.0, self.tremor - dt * 6)
        a = self.tremor * self.tremor * 3
        self.dx, self.dy = (rng.random() - 0.5) * a, (rng.random() - 0.5) * a

    def tx(self, wx):
        return (wx - self.x + self.dx) * self.escala

    def ty(self, wy):
        # o fundo do mundo (y = MUNDO_H) encosta no fundo da tela; sobra céu em cima
        return self.H - (MUNDO_H - (wy - self.y + self.dy)) * self.escala

    def px(self, w):
        """Tamanho em pixels de uma medida do mundo."""
        return w * self.escala


def colide(a, b, folga=0.15):
    """AABB (x, y, w, h) com as caixas encolhidas em `folga` de cada lado: passar
    raspando conta como passar."""
    ax, ay, aw, ah = a
    bx, by, bw, bh = b
    fa, fb = aw * folga, bw * folga
    ga, gb = ah * folga, bh * folga
    return (ax + fa < bx + bw - fb and bx + fb < ax + aw - fa and
            ay + ga < by + bh - gb and by + gb < ay + ah - ga)


class Particulas:
    """Pool de partículas reaproveitável: posição, velocidade, vida, gravidade e cor."""

    def __init__(self, tamanho=160):
        self.p = [[0.0] * 8 + [None] for _ in range(tamanho)]  # x y vx vy vida total grav tam cor
        self.livre = 0

    def emitir(self, x, y, vx, vy, vida, cor, grav=0.0, tam=1.0):
        for k in range(len(self.p)):
            i = (self.livre + k) % len(self.p)
            if self.p[i][4] <= 0:
                self.p[i][:] = [x, y, vx, vy, vida, vida, grav, tam, cor]
                self.livre = i + 1
                return

    def explodir(self, rng, x, y, n, vel, vida, cores, grav=0.0, tam=1.0, cone=(0, 2 * math.pi)):
        for _ in range(n):
            ang = cone[0] + rng.random() * (cone[1] - cone[0])
            v = vel * (0.4 + 0.6 * rng.random())
            self.emitir(x, y, math.cos(ang) * v, math.sin(ang) * v, vida * (0.6 + 0.4 * rng.random()),
                        cores[rng.randrange(len(cores))], grav, tam)

    def atualizar(self, dt):
        for q in self.p:
            if q[4] > 0:
                q[3] += q[6] * dt
                q[0] += q[2] * dt
                q[1] += q[3] * dt
                q[4] -= dt

    def vivas(self):
        return [q for q in self.p if q[4] > 0]

    def desenhar(self, tela, cam=None):
        for x, y, _, _, vida, total, _, tam, cor in self.vivas():
            sx, sy = (cam.tx(x), cam.ty(y)) if cam else (x, y)
            r = (cam.px(tam) if cam else tam) * (0.5 + 0.5 * vida / total)
            if r < 0.9:
                tela.misturar(sx, sy, cor, min(1.0, vida / total * 1.5))
            else:
                tela.brilho(sx, sy, r * 1.6, cor, min(1.0, vida / total * 1.5))


class Recordes:
    """Melhores pontuações por jogo, em $XDG_DATA_HOME/termboy/recordes.json."""

    MAX = 5

    def __init__(self, caminho=None):
        if caminho is None:
            base = os.environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"), ".local", "share")
            caminho = os.path.join(base, "termboy", "recordes.json")
        self.caminho = caminho

    def carregar(self):
        try:
            with open(self.caminho) as f:
                dados = json.load(f)
            return dados if isinstance(dados, dict) else {}
        except (OSError, ValueError):
            return {}

    def tabela(self, jogo):
        return self.carregar().get(jogo, [])

    def registrar(self, jogo, pontos):
        """Grava a pontuação se ela entrar na tabela. Devolve a posição (0 = melhor) ou None."""
        dados = self.carregar()
        tab = dados.get(jogo, [])
        item = {"pontos": int(pontos), "data": time.strftime("%Y-%m-%d")}
        tab.append(item)
        tab.sort(key=lambda r: -r["pontos"])
        tab = tab[: self.MAX]
        if item not in tab or pontos <= 0:
            return None
        dados[jogo] = tab
        try:
            os.makedirs(os.path.dirname(self.caminho), exist_ok=True)
            tmp = self.caminho + ".tmp"
            with open(tmp, "w") as f:
                json.dump(dados, f, indent=1)
            os.replace(tmp, self.caminho)
        except OSError:
            return None
        return tab.index(item)


# ======================================================================== motor: laço
PASSO = 1 / 30


class Laco:
    """Lógica em passo fixo (30 Hz) com acumulador; o desenho roda na taxa que der."""

    def __init__(self, entrada, saida, fps=30):
        self.entrada, self.saida, self.fps = entrada, saida, fps
        self.redimensionou = False

    def rodar(self, atualizar, desenhar):
        """atualizar(dt, entrada) devolve None para continuar; desenhar() devolve a Tela."""
        acum, antes = 0.0, time.monotonic()
        while True:
            agora = time.monotonic()
            acum += min(agora - antes, 0.25)  # evita a espiral depois de uma travada
            antes = agora
            self.entrada.ler(agora)
            while acum >= PASSO:
                r = atualizar(PASSO, self.entrada)
                self.entrada.fim_do_tick()
                acum -= PASSO
                if r is not None:
                    return r
            if self.redimensionou:
                self.redimensionou = False
                self.saida.forcar()
            self.saida.confirmado(self.entrada.confirmacoes())
            if self.saida.pronta(agora):
                self.saida.mostrar(desenhar())
                self.entrada.esperar(1 / self.fps - (time.monotonic() - agora))
            else:
                self.entrada.esperar(PASSO / 4)  # o terminal ainda não engoliu os quadros anteriores


