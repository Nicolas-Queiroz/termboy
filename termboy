LARANJA = [(150, 62, 22), (205, 100, 36), (240, 146, 62), (255, 196, 120)]


@functools.lru_cache(maxsize=64)
def gato(h, quadro=0, forma="normal", morto=False):
    """Pipoca, gato laranja de cachecol, correndo para a direita.

    quadro: 0-3 ciclo de corrida, 4 no ar. forma: normal, achatado (pouso) ou esticado (pulo)."""
    h = max(6, int(h))
    sx, sy = {"normal": (1.0, 1.0), "achatado": (1.18, 0.82), "esticado": (0.88, 1.14)}[forma]
    w = int(h * 1.5 * sx)
    s = Spr(w, h)
    X = lambda u: u * w
    Y = lambda v: h - (1 - v) * h * sy  # achata em direção ao chão
    escuro = (120, 46, 18)
    # rabo em S, saindo da traseira para cima
    for k in range(9):
        a = k / 8
        tx, ty = X(0.2 - 0.12 * a - 0.04 * math.sin(a * 3)), Y(0.48 - 0.42 * a)
        s.elipse(tx, ty, max(0.6, h * 0.07), max(0.6, h * 0.07), cor=LARANJA[1] if k % 3 else escuro)
    # pernas: duas de cada lado, defasadas
    if quadro == 4:
        pernas = [(0.3, -0.12), (0.4, -0.08), (0.68, 0.1), (0.78, 0.14)]
    else:
        fase = [0.0, 0.5, 1.0, 0.5][quadro % 4]
        pernas = [(0.3, -0.06 + 0.12 * fase), (0.4, 0.06 - 0.12 * fase),
                  (0.66, 0.06 - 0.12 * fase), (0.76, -0.06 + 0.12 * fase)]
    for i, (px, desvio) in enumerate(pernas):
        cor = LARANJA[0] if i % 2 == 0 else LARANJA[1]
        s.poligono([(X(px - 0.04), Y(0.62)), (X(px + 0.05), Y(0.62)),
                    (X(px + 0.05 + desvio), Y(0.98)), (X(px - 0.04 + desvio), Y(0.98))], [cor, cor])
    s.elipse(X(0.5), Y(0.56), X(0.3), h * sy * 0.2, LARANJA)
    s.elipse(X(0.8), Y(0.38), X(0.15), h * sy * 0.2, LARANJA)
    for ex in (0.71, 0.86):
        s.poligono([(X(ex - 0.055), Y(0.26)), (X(ex), Y(0.02)), (X(ex + 0.06), Y(0.26))], LARANJA[1:])
    s.contorno((60, 22, 12))
    for k in range(3):  # listras
        x = X(0.36 + k * 0.1)
        s.linha(x, Y(0.4), x - h * 0.04, Y(0.52), escuro)
    for ex in (0.71, 0.86):
        s.px[(int(X(ex)), int(Y(0.16)))] = (255, 170, 170)
    s.elipse(X(0.92), Y(0.44), X(0.05), h * sy * 0.06, cor=(255, 236, 214))  # focinho
    s.px[(int(X(0.965)), int(Y(0.4)))] = (230, 90, 110)
    if morto:
        ox, oy = int(X(0.84)), int(Y(0.33))
        for d in (-1, 0, 1):
            s.px[(ox + d, oy + d)] = s.px[(ox + d, oy - d)] = (20, 14, 20)
    else:
        olho = s.elipse(X(0.84), Y(0.33), max(0.6, X(0.022)), max(0.7, h * sy * 0.06), cor=(20, 14, 20))
        if olho and h >= 14:
            s.px[min(olho, key=lambda p: (p[1], p[0]))] = (255, 255, 255)
    cachecol = [(150, 20, 30), (210, 40, 50), (250, 90, 90)]
    s.poligono([(X(0.66), Y(0.44)), (X(0.76), Y(0.42)), (X(0.78), Y(0.56)), (X(0.66), Y(0.58))], cachecol)
    s.poligono([(X(0.66), Y(0.5)), (X(0.6), Y(0.56)), (X(0.52), Y(0.7)), (X(0.6), Y(0.62))], cachecol)
    return s


@functools.lru_cache(maxsize=16)
def novelo(h, cor=(236, 96, 150)):
    """Novelo de lã com fio solto."""
    h = max(3, int(h))
    s = Spr(h + 2, h + 1)
    rampa = [escurecer(cor, 0.45), escurecer(cor, 0.2), cor, clarear(cor, 0.4)]
    r = h / 2
    s.elipse(r, r, r, r, rampa)
    if h >= 6:
        for k in (-0.4, 0.0, 0.4):
            for a in range(10):
                ang = -1.2 + a * 0.24
                x, y = r + math.cos(ang) * r * 0.75 + k * r * 0.5, r + math.sin(ang) * r * 0.75 * 0.6
                if (x - r) ** 2 + (y - r) ** 2 < r * r * 0.8:
                    s.px[(int(x), int(y))] = escurecer(cor, 0.35)
    s.contorno(escurecer(cor, 0.7))
    s.linha(r + r * 0.7, r + r * 0.6, h + 1, h, escurecer(cor, 0.3))
    return s


@functools.lru_cache(maxsize=32)
def caixa(w, h):
    """Caixote de madeira com tábuas e travessa em X."""
    w, h = max(3, int(w)), max(3, int(h))
    s = Spr(w, h)
    mad = [(110, 64, 30), (150, 92, 44), (186, 124, 64), (214, 160, 96)]
    s.poligono([(0, 0), (w, 0), (w, h), (0, h)], mad)
    b = max(1, int(min(w, h) * 0.14))
    escura = (90, 50, 24)
    s.ret(0, 0, w, b, escura)
    s.ret(0, h - b, w, h, escura)
    s.ret(0, 0, b, h, escura)
    s.ret(w - b, 0, w, h, escura)
    if min(w, h) >= 6:
        s.linha(b, b, w - b - 1, h - b - 1, escura)
        s.linha(b, h - b - 1, w - b - 1, b, escura)
    s.contorno((50, 26, 12))
    return s


def arvores(tela, off, base, alt, cor=(56, 130, 70), denso=1.0):
    """Fila de árvores redondas em parallax (off em pixels)."""
    passo = max(4.0, alt * 0.9 / denso)
    k0 = int(math.floor(off / passo)) - 1
    for k in range(k0, k0 + int(tela.W / passo) + 3):
        x = k * passo - off + (_hash(k, 11) - 0.5) * passo * 0.6
        a = alt * (0.7 + 0.5 * _hash(k, 12))
        r = max(1.5, a * 0.42)
        tela.retangulo(x - max(0.5, r * 0.18), base - a * 0.35, x + max(0.5, r * 0.18) + 1, base + 1, (88, 58, 40))
        for y in range(int(base - a - r * 0.2), int(base - a * 0.3) + 1):
            for xx in range(int(x - r) - 1, int(x + r) + 2):
                dx, dy = (xx + 0.5 - x) / r, (y + 0.5 - (base - a * 0.68)) / (r * 1.05)
                if dx * dx + dy * dy <= 1:
                    luz = -dx * 0.5 - dy * 0.6
                    tela.ponto(xx, y, clarear(cor, 0.22) if luz > 0.35 else escurecer(cor, 0.25) if luz < -0.3 else cor)


def chao_tijolos(tela, gy, off, escala=1.0, buracos=()):
    """Gramado em cima e terra de tijolos embaixo. buracos: intervalos [x0, x1) em pixels de tela."""
    if gy >= tela.H:
        return
    c_grama, c_grama2 = tela.c((96, 186, 72)), tela.c((60, 140, 52))
    c_terra, c_terra2, c_junta = tela.c((150, 92, 52)), tela.c((128, 76, 42)), tela.c((92, 52, 30))
    tw, th = max(3, int(6 * escala)), max(2, int(3 * escala))
    grama = max(1, int(1.6 * escala))
    gy = int(gy)
    for y in range(max(0, gy), tela.H):
        linha = tela.px[y]
        d = y - gy
        fila = d // th
        for x in range(tela.W):
            wx = x + off
            if d < grama:
                c = c_grama if (int(wx) + d) % 5 else c_grama2
            elif d == grama:
                c = c_grama2
            elif (d % th) == 0 or (int(wx) + (fila % 2) * (tw // 2)) % tw == 0:
                c = c_junta
            else:
                c = c_terra if (fila + int(wx) // tw) % 3 else c_terra2
            linha[x] = c
    for x0, x1 in buracos:
        for y in range(max(0, gy), tela.H):
            p = (y - gy) / max(1, tela.H - gy)
            tela.retangulo(x0, y, x1, y + 1, lerp_cor((30, 22, 40), (6, 4, 12), p))
        tela.retangulo(x0, gy, x0 + 1, tela.H, (70, 40, 24))
        tela.retangulo(x1 - 1, gy, x1, tela.H, (70, 40, 24))


CEU_AURORA = [(0, (40, 60, 140)), (0.5, (200, 120, 160)), (1, (255, 200, 150))]


def colinas(tela, off, gy, ceu=CEU_DIA, noite=0.0):
    """Cenário de fundo do Pulo do Gato: céu, montanhas, nuvens e árvores em parallax."""
    tela.ceu(ceu)
    if noite > 0:
        estrelas(tela, off * 0.02, 0.6)
    H = tela.H
    montanhas(tela, gy, H * 0.42, off * 0.1, escurecer((130, 160, 210), noite * 0.6), 0.5, neve=(240, 245, 255))
    if noite < 0.5:
        nuvens(tela, -off * 0.08, vel=1)  # andam para trás, mais devagar que o chão
    montanhas(tela, gy, H * 0.24, off * 0.25 + 40, escurecer((92, 160, 110), noite * 0.6), 2.3)
    arvores(tela, off * 0.5, gy, H * 0.2, escurecer((50, 128, 64), noite * 0.6))


def gato_salto(t, t0, dur, alt):
    """Altura de um pulo parabólico que começa em t0."""
    q = (t - t0) / dur
    return 4 * alt * q * (1 - q) if 0 <= q <= 1 else 0.0


def gato_abertura(tela, t):
    W, H = tela.W, tela.H
    gy = int(H * 0.8)
    hg = int(min(H * 0.24, W * 0.14))
    if t < 3.0:
        p = ease(t / 3.0)
        ceu = [(s, lerp_cor(c, d, p)) for (s, c), (_, d) in zip(
            [(0, (10, 12, 40)), (0.5, (60, 40, 110)), (1, (150, 80, 120))],
            [(0, (64, 120, 225)), (0.5, (190, 150, 190)), (1, (255, 210, 150))])]
        colinas(tela, 0, gy, ceu, noite=1 - p)
        sy = lerp(H * 0.85, H * 0.3, p)
        tela.brilho(W * 0.75, sy, H * 0.35, (255, 220, 150), 0.6)
        tela.circulo(W * 0.75, sy, max(2, H * 0.08), (255, 240, 190))
        chao_tijolos(tela, gy, 0)
        if hg >= 6:
            tela.sombra(W * 0.3 + hg * 0.7, gy + 1, hg * 0.6, max(1, hg * 0.08))
            tela.desenhar(gato(hg, 0, "achatado"), W * 0.3, gy - hg + 1)
            for k in range(3):
                q = (t * 0.6 + k / 3) % 1
                tela.letra("Z", W * 0.3 + hg * 1.2 + q * hg * 0.6, gy - hg - q * hg * 0.8, 1,
                           lerp_cor((255, 255, 255), (150, 150, 200), q))
        if 0.8 <= t <= 2.8:
            a = min(1, (t - 0.8) / 0.4, (2.8 - t) / 0.4)
            tela.texto(tela.rows // 4, "No alto das colinas, um gato acorda...", lerp_cor((20, 20, 50), (255, 255, 255), a))
        return
    if t < 10.0:
        vel = W * 0.55
        off = (t - 3.0) * vel
        colinas(tela, off, gy)
        tela.brilho(W * 0.85, H * 0.18, H * 0.25, (255, 250, 210), 0.5)
        # buracos e pulos sincronizados: o gato pula em tp e o buraco passa embaixo dele
        gx = W * 0.25
        pulos = [4.4, 5.6, 6.9, 8.2]
        buracos = []
        for tp in pulos:
            centro = gx + hg * 0.75 + (tp + 0.35 - t) * vel
            buracos.append((centro - hg * 0.6, centro + hg * 0.6))
        chao_tijolos(tela, gy, off, max(1.0, H / 48), buracos)
        alt = sum(gato_salto(t, tp, 0.7, hg * 1.4) for tp in pulos)
        no_ar = alt > 0
        for k in range(10):
            nx = gx + (pulos[k % 4] + 0.35 - t) * vel + (k // 4) * hg * 0.4
            ny = gy - hg * 2.1 + math.sin(t * 5 + k) * 1.5
            pego = t > pulos[k % 4] + 0.3 and k < 8
            if not pego and -hg < nx < W + hg:
                tela.brilho(nx + hg * 0.15, ny + hg * 0.15, hg * 0.4, (255, 200, 220), 0.4)
                tela.desenhar(novelo(hg * 0.35), nx, ny)
        quadro = 4 if no_ar else int(t * 12) % 4
        forma = "esticado" if 0 < alt and any(0 <= t - tp < 0.2 for tp in pulos) else \
            "achatado" if any(0 <= t - tp - 0.7 < 0.1 for tp in pulos) else "normal"
        tela.sombra(gx + hg * 0.75, gy + 1, hg * 0.6 * (1 - alt / (hg * 3)), max(1, hg * 0.08))
        tela.desenhar(gato(hg, quadro, forma), gx, gy - hg + 1 - alt)
        for tp in pulos:
            q = (t - tp - 0.7) / 0.5
            if 0 <= q < 1:
                for k in range(5):
                    tela.brilho(gx + hg * (0.2 + 0.25 * k) - q * hg * 0.8, gy - q * hg * 0.3, hg * 0.12,
                                (220, 200, 160), 0.7 * (1 - q))
        if t >= 9.4:
            tela.flash((t - 9.4) / 0.6)
        return
    colinas(tela, t * 6, gy, CEU_POR)
    tela.brilho(W * 0.5, gy, H * 0.5, (255, 200, 140), 0.5)
    chao_tijolos(tela, gy, t * 6, max(1.0, H / 48))
    if t < 10.4:
        tela.flash(1 - (t - 10.0) / 0.4)
    fim = titulo(tela, ["PULO DO", "GATO"], t, 10.2, [(255, 250, 200), (255, 210, 80), (240, 130, 40)],
                 contorno=(50, 24, 10), sombra=(120, 50, 30), entrada="cair")
    hh = int(min(hg * 1.3, max(0, gy - fim - 4)))
    if hh >= 8 and t >= 10.8:
        q = ease((t - 10.8) / 0.8)
        gx = lerp(-hh * 2, W * 0.5 - hh * 0.75, q)
        pulo = gato_salto(t, 12.0 + int((t - 12.0) / 1.6) * 1.6, 0.6, hh * 0.6) if t >= 12.0 else 0
        tela.sombra(gx + hh * 0.75, gy + 1, hh * 0.6, max(1, hh * 0.08))
        tela.desenhar(gato(hh, 4 if pulo else int(t * 10) % 4 if q < 1 else 0), gx, gy - hh + 1 - pulo)
    for k in range(6):
        fase = (t * 0.5 + k / 6) % 1
        x = (k * 0.17 + 0.08) * W
