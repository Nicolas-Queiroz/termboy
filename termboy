@functools.lru_cache(maxsize=64)
def carro(w, cor):
    """Carro esportivo visto de trás."""
    w = max(6, int(w))
    h = max(4, int(w * 0.5))
    s = Spr(w, h)
    rampa = [escurecer(cor, 0.45), escurecer(cor, 0.2), cor, clarear(cor, 0.3)]
    for fx in (0.06, 0.74):
        s.ret(w * fx, h * 0.62, w * (fx + 0.2), h, (22, 22, 28))
        s.ret(w * fx, h * 0.66, w * (fx + 0.2), h * 0.66 + 1, (60, 60, 70))
    s.poligono([(w * 0.02, h * 0.45), (w * 0.98, h * 0.45), (w * 0.96, h * 0.86), (w * 0.04, h * 0.86)], rampa, "vert")
    s.poligono([(w * 0.22, h * 0.1), (w * 0.78, h * 0.1), (w * 0.9, h * 0.47), (w * 0.1, h * 0.47)], rampa, "vert")
    s.poligono([(w * 0.27, h * 0.16), (w * 0.73, h * 0.16), (w * 0.82, h * 0.42), (w * 0.18, h * 0.42)],
               [(25, 32, 60), (45, 62, 105), (80, 108, 160), (150, 180, 220)], "vert")
    s.ret(0, h * 0.28, w, h * 0.35, escurecer(cor, 0.55))
    s.ret(w * 0.12, h * 0.35, w * 0.16, h * 0.45, escurecer(cor, 0.55))
    s.ret(w * 0.84, h * 0.35, w * 0.88, h * 0.45, escurecer(cor, 0.55))
    s.contorno((18, 10, 16))
    for fx in (0.07, 0.73):
        s.ret(w * fx, h * 0.52, w * (fx + 0.2), h * 0.62, (255, 50, 50))
        s.ret(w * fx, h * 0.52, w * (fx + 0.2), h * 0.52 + 1, (255, 170, 160))
    s.ret(w * 0.4, h * 0.6, w * 0.6, h * 0.72, (230, 228, 205))
    return s


PREDIOS = [(RNG.random(), 0.03 + RNG.random() * 0.05, 0.2 + RNG.random() * 0.8, RNG.randint(0, 999)) for _ in range(28)]
CEU_CORRIDA = [(0, (28, 18, 78)), (0.45, (190, 64, 112)), (0.8, (255, 146, 80)), (1, (255, 222, 140))]


def turbo_posicao(t):
    pos, v, passo, x = 0.0, 0.0, 0.05, 3.0
    while x < t:
        if x < 5.0:
            v = 6 * ease((x - 3.0) / 2.0)
        elif 8.0 <= x < 10.5:
            v = 6 + 5 * ease((x - 8.0) / 0.6)
        else:
            v = 6
        pos += v * passo
        x += passo
    return pos


def turbo_pista(tela, pos, curva, hz):
    W, H = tela.W, tela.H
    tela.ceu(CEU_CORRIDA, y1=hz + 1)
    sx = W * 0.5 - curva * W * 0.25
    r = max(3, H * 0.17)
    tela.brilho(sx, hz, r * 2.6, (255, 190, 120), 0.55)
    for y in range(int(hz - r), hz + 1):
        if y > hz - r * 0.55 and y % 3 == 0:
            continue
        for x in range(int(sx - r), int(sx + r) + 1):
            if (x + 0.5 - sx) ** 2 + (y + 0.5 - hz) ** 2 <= r * r:
                tela.ponto(x, y, lerp_cor((255, 236, 120), (255, 110, 90), (y - (hz - r)) / r))
    largura = W * 1.6
    c_pred, c_jan = (38, 22, 66), (255, 205, 120)
    for fx, fw, fh, sem in PREDIOS:
        bx = (fx * largura - curva * W * 0.35) % largura - W * 0.3
        bw, bh = max(2, fw * W), fh * H * 0.22
        tela.retangulo(bx, hz - bh, bx + bw, hz + 1, c_pred)
        for yy in range(int(hz - bh) + 1, hz - 1, 2):
            for xx in range(int(bx) + 1, int(bx + bw) - 1, 2):
                if _hash(xx + sem, yy) > 0.62:
                    tela.ponto(xx, yy, c_jan)
    cores = {k: tela.c(v) for k, v in {
        "g1": (72, 170, 72), "g2": (58, 148, 58), "a1": (104, 104, 116), "a2": (94, 94, 106),
        "z1": (236, 236, 236), "z2": (214, 42, 42), "faixa": (245, 245, 245)}.items()}
    for y in range(hz + 1, H):
        p = (y - hz) / max(1, H - hz)
        z = 1 / max(p, 0.02)
        meia = W * 0.03 + p * W * 0.5
        cx = W / 2 + curva * W * 0.7 * (1 - p) ** 2
        fase = int(z * 2.2 + pos) % 2
        g, a, zb = (cores["g1"], cores["a1"], cores["z1"]) if fase else (cores["g2"], cores["a2"], cores["z2"])
        linha = tela.px[y]
        for x in range(W):
            d = abs(x + 0.5 - cx)
            if d < meia * 0.035 and fase:
                linha[x] = cores["faixa"]
            elif d < meia:
                linha[x] = a
            elif d < meia * 1.13:
                linha[x] = zb
            else:
                linha[x] = g


def turbo(tela, t):
    W, H = tela.W, tela.H
    hz = int(H * 0.42)
    cw = int(min(W * 0.3, H * 0.75))
    if t < 11.0:
        pos = turbo_posicao(t) if t > 3 else 0.0
        curva = math.sin((t - 3) * 0.45) * 0.8 if t > 3 else 0.0
        turbo_pista(tela, pos, curva, hz)
        cx_carro = W / 2 + curva * W * 0.04 + (math.sin(t * 9) * 0.5 if t > 3 else 0)
