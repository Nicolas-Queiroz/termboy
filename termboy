@functools.lru_cache(maxsize=1024)
def ladrilho(tipo, T, var, luz, estilo, frente=False):
    """Linhas de pixels de uma célula já iluminada (luz 0-8) e convertida para o estilo."""
    linhas = []
    for y in range(T):
        linha = []
        for x in range(T):
            if tipo == PAREDE:
                tw, th = max(2, T // 2), max(2, T // 3)
                fila = y // th
                junta = y % th == th - 1 or (x + (fila % 2) * (tw // 2) + var) % tw == 0
                c = (40, 36, 54) if junta else (96, 92, 120) if _hash(x // tw + var, fila + var) > 0.6 else (78, 74, 100)
                if frente and y >= T * 0.6:
                    c = escurecer(c, 0.35)
            elif tipo == "escada":
                degrau = y * 4 // T
                c = escurecer((120, 104, 90), degrau * 0.2) if x % max(2, T // 4) else (40, 30, 30)
            else:
                borda = x == 0 or y == 0
                c = (52, 46, 58) if borda else (84, 76, 88) if _hash(x + var * 13, y + var * 7) > 0.85 else (70, 64, 76)
            if luz == 0:  # lembrado, fora da luz: escuro e azulado
                c = lerp_cor((4, 4, 12), lerp_cor(c, (60, 70, 120), 0.5), 0.28)
            elif luz < 8:
                c = lerp_cor((3, 2, 8), c, 0.3 + 0.7 * (luz / 8) ** 1.2)
            else:
                c = lerp_cor(c, (255, 190, 120), 0.12)
            linha.append(conv(c, estilo))
        linhas.append(linha)
    return linhas


class CamGrade:
    """Câmera em células da masmorra (para partículas e sprites)."""

    def __init__(self, T, cx, cy, W, H):
        self.T, self.cx, self.cy, self.W, self.H = T, cx, cy, W, H

    def tx(self, x):
        return (x - self.cx) * self.T + self.W / 2

    def ty(self, y):
        return (y - self.cy) * self.T + self.H / 2

    def px(self, w):
        return w * self.T


class TochaEterna(Jogo):
    nome, titulo, abertura = "tocha", "Tocha Eterna", "tocha"
    dicas = "setas/wasd anda e ataca   espaço espera   p pausa   q sai"
    COMBUSTIVEL = 100
    CONSUMO = 0.5  # por turno
    VIDA = 6

    def iniciar(self, semente):
        super().iniciar(semente)
        self.vida, self.oleo, self.cristais, self.abatidos = self.VIDA, float(self.COMBUSTIVEL), 0, []
        self.part = Particulas(160)
        self.msg, self.t_msg = "", -9.0
        self.morreu_em = None
        self.t_dano = -9.0
        self.ultimo_turno = -9.0
        self.turno = 0
        self.novo_andar(1)

    def novo_andar(self, numero):
        self.andar = Andar(self.semente, numero)
        self.heroi = Criatura("heroi", *self.andar.entrada, self.vida)
        self.explorado = set()
        self.t_andar = self.t
        self._ver()

    def raio(self):
        return 1.5 if self.oleo <= 0 else 2.2 + 5.8 * self.oleo / self.COMBUSTIVEL

    def _ver(self):
        self.visivel = self.andar.visiveis((self.heroi.x, self.heroi.y), self.raio())
        self.explorado |= self.visivel

    def pontos(self):
        return 100 * self.cristais + sum(INIMIGOS[t][2] for t in self.abatidos) + 250 * (self.andar.numero - 1)

    def avisar(self, msg):
        self.msg, self.t_msg = msg, self.t

    def atualizar(self, dt, ent):
        super().atualizar(dt, ent)
        self.part.atualizar(dt)
        if self.oleo > 0 and self.rng.random() < 0.3:
            h = self.heroi
            self.part.emitir(h.x + 0.5 + (self.rng.random() - 0.5) * 0.3, h.y - 0.2, (self.rng.random() - 0.5) * 0.6,
                             -1.2 - self.rng.random(), 0.6, (255, 170, 70), tam=0.08)
        if self.morreu_em is not None:
            return "fim" if self.t - self.morreu_em > 1.8 else None
        if self.t - self.ultimo_turno < 0.09:  # uma ação por animação, mesmo segurando a tecla
            return None
        for acao, (dx, dy) in DIRECOES.items():
            if ent.apertou(acao, repetir=True):
                self._turno(dx, dy)
                return None
        if ent.apertou("acao", repetir=True):
            self._turno(0, 0)
        return None

    def _turno(self, dx, dy):
        h, a = self.heroi, self.andar
        self.ultimo_turno = self.t
        self.turno += 1
        nx, ny = h.x + dx, h.y + dy
        alvo = next((c for c in a.inimigos if (c.x, c.y) == (nx, ny)), None)
        if dx == dy == 0:
            pass
        elif alvo:
            self._ferir(alvo, 1)
            h.mover(h.x, h.y, self.t)
        elif a.livre(nx, ny):
            h.mover(nx, ny, self.t)
        else:
            return
        antes, self.oleo = self.oleo, max(0.0, self.oleo - self.CONSUMO)
        if antes > 0 and self.oleo == 0:
            self.avisar("A tocha apagou!")
        self._pegar()
        if (h.x, h.y) == a.escada:
            self.oleo = min(self.COMBUSTIVEL, self.oleo + 15)
            self.novo_andar(a.numero + 1)
            self.avisar(f"Andar {self.andar.numero}. Mais fundo...")
            return
        self._inimigos()
        self._ver()

    def _pegar(self):
        h, a = self.heroi, self.andar
        item = a.itens.pop((h.x, h.y), None)
        cores = {"oleo": [(255, 200, 80), (255, 140, 40)], "cristal": [(150, 220, 255), (255, 255, 255)],
                 "coracao": [(255, 120, 130), (255, 220, 220)]}
        if item:
            self.part.explodir(self.rng, h.x + 0.5, h.y + 0.5, 12, 3.0, 0.6, cores[item], tam=0.12)
        if item == "oleo":
            self.oleo = min(self.COMBUSTIVEL, self.oleo + 40)
            self.avisar("Óleo! A tocha reacende.")
        elif item == "cristal":
            self.cristais += 1
            self.avisar("Um cristal azul!")
        elif item == "coracao":
            self.vida = min(self.VIDA, self.vida + 1)
            self.avisar("Você se sente melhor.")

    def _ferir(self, c, dano):
        c.vida -= dano
        c.t_dano = self.t
        self.part.explodir(self.rng, c.x + 0.5, c.y + 0.5, 6, 2.5, 0.3, [(255, 255, 255), (255, 200, 120)], tam=0.1)
        if c.vida <= 0:
            self.andar.inimigos.remove(c)
            self.abatidos.append(c.tipo)
            cor = {"gosma": (110, 210, 90), "vulto": (120, 80, 170), "pedrusco": (150, 140, 140)}[c.tipo]
            self.part.explodir(self.rng, c.x + 0.5, c.y + 0.5, 16, 3.5, 0.7, [cor, clarear(cor, 0.4)], grav=4, tam=0.14)
            self.avisar(f"{c.tipo.capitalize()} derrotado!")

    def _inimigos(self):
        h, a = self.heroi, self.andar
        dist = a.distancias((h.x, h.y))
        ocupado = {(c.x, c.y) for c in a.inimigos}
        luz = self.visivel if self.oleo > 0 else set()
        for c in list(a.inimigos):
            c.turnos += 1
            d = dist.get((c.x, c.y), 99)
            if d > 9:
                continue  # longe demais: dorme
            if c.tipo == "pedrusco" and c.turnos % 2:
                continue
            if d == 1 and not (c.tipo == "vulto" and (c.x, c.y) in luz):
                self._atacado(c)
                continue
            fugir = c.tipo == "vulto" and (c.x, c.y) in luz
            opcoes = []
            for dx, dy in DIRECOES.values():
                p = (c.x + dx, c.y + dy)
                if p in dist and p not in ocupado and p != (h.x, h.y):
                    opcoes.append((-dist[p] if fugir else dist[p], p))
            if opcoes:
                melhor, p = min(opcoes)
                atual = -d if fugir else d
                if melhor < atual:
                    ocupado.discard((c.x, c.y))
                    c.mover(*p, self.t)
                    ocupado.add(p)

    def _atacado(self, c):
        dano = INIMIGOS[c.tipo][1]
        self.vida -= dano
        self.t_dano = self.t
        c.mover(c.x, c.y, self.t)
        self.avisar({"gosma": "A gosma te queima!", "vulto": "Algo te arranha no escuro!",
                     "pedrusco": "O pedrusco te esmaga!"}[c.tipo])
        self.part.explodir(self.rng, self.heroi.x + 0.5, self.heroi.y + 0.5, 10, 3.0, 0.4,
                           [(255, 60, 60), (255, 160, 160)], grav=3, tam=0.12)
        if self.vida <= 0:
            self.vida = 0
            self.morreu_em = self.t
            self.avisar("A chama se apaga para sempre...")

    def desenhar(self, tela):
        a, h = self.andar, self.heroi
        T = max(6, min(tela.W // 12, tela.H // 7))
        hx, hy = h.pos_desenho(self.t)
        cam = CamGrade(T, hx + 0.5, hy + 0.5, tela.W, tela.H)
        tela.retangulo(0, 0, tela.W, tela.H, (3, 2, 8))
        raio = self.raio()
        tq = int(self.t * 8) / 8  # a luz tremula 8 vezes por segundo: menos células mudam por quadro
        tremor = 0.92 + 0.08 * math.sin(tq * 11) * math.sin(tq * 7.3)
        cols = tela.W // T + 3
        rows = tela.H // T + 3
        x0, y0 = int(cam.cx - cols / 2), int(cam.cy - rows / 2)
        apagada = self.oleo <= 0 or self.morreu_em is not None
        for gy in range(y0, y0 + rows):
            for gx in range(x0, x0 + cols):
                if (gx, gy) not in self.explorado:
                    continue
                tipo = a.grade[gy][gx]
                if (gx, gy) == a.escada:
                    tipo = "escada"
                if (gx, gy) in self.visivel and not apagada:
                    d = math.hypot(gx - h.x, gy - h.y) / max(1.0, raio)
                    luz = max(1, min(8, int(9 * (1 - d * d) * tremor)))
                else:
                    luz = 0
                frente = tipo == PAREDE and gy + 1 < a.H and a.grade[gy + 1][gx] == PISO
                linhas = ladrilho(tipo, T, (gx * 7 + gy * 3) % 5, luz, tela.estilo, frente)
                sx, sy = int(cam.tx(gx)), int(cam.ty(gy))
                for k, linha in enumerate(linhas):
                    yy = sy + k
                    if 0 <= yy < tela.H:
                        a0, b0 = max(0, sx), min(tela.W, sx + T)
                        if a0 < b0:
                            tela.px[yy][a0:b0] = linha[a0 - sx:b0 - sx]
        # itens e criaturas só onde a tocha alcança
        for (ix, iy), item in a.itens.items():
            if (ix, iy) in self.visivel and not apagada:
                bob = math.sin(self.t * 3 + ix) * T * 0.08
                spr = {"oleo": frasco, "cristal": cristal, "coracao": coracao}[item](T * 0.7)
                cx, cy = cam.tx(ix + 0.5), cam.ty(iy + 0.5) + bob
                tela.brilho(cx, cy, T * 0.8, {"oleo": (255, 180, 60), "cristal": (120, 200, 255),
                                               "coracao": (255, 100, 120)}[item], 0.4)
                tela.desenhar(spr, cx - spr.w / 2, cy - spr.h / 2)
        fase = int(self.t * 4)
        for c in a.inimigos:
            if (c.x, c.y) not in self.visivel or apagada:
                continue
            ex, ey = c.pos_desenho(self.t)
            spr = {"gosma": gosma, "vulto": vulto, "pedrusco": pedrusco}[c.tipo](T * 1.0, fase)
            d = math.hypot(c.x - h.x, c.y - h.y) / max(1.0, raio)
            sombra = min(0.85, max(0.0, d * d))
            tinta = (255, 255, 255) if self.t - c.t_dano < 0.15 else (0, 0, 0)
            forca = 0.8 if tinta[0] else sombra
            sx, sy = cam.tx(ex + 0.5) - spr.w / 2, cam.ty(ey + 1) - spr.h
            tela.sombra(cam.tx(ex + 0.5), cam.ty(ey + 0.95), T * 0.35, max(1, T * 0.1))
            tela.desenhar(spr, sx, sy, tinta, forca)
        self._desenhar_heroi(tela, cam, hx, hy)
        self.part.desenhar(tela, cam)
        if not apagada:
            tela.brilho(tela.W / 2, tela.H / 2 - T * 0.5, T * raio * 0.9 * tremor, (255, 160, 80), 0.18)
        if self.t - self.t_dano < 0.25:
            tela.flash(0.35 * (1 - (self.t - self.t_dano) / 0.25), (255, 30, 30))
        if self.t - self.t_andar < 0.6:
            tela.flash(1 - (self.t - self.t_andar) / 0.6, (0, 0, 0))
        self._hud(tela)

    def _desenhar_heroi(self, tela, cam, hx, hy):
        T = cam.T
        spr = mago(T * 1.35, int(self.t * 6) % 4 if self.t - self.heroi.t_mov < 0.1 else 0)
        sx, sy = cam.tx(hx + 0.5) - spr.w / 2, cam.ty(hy + 1) - spr.h
        if self.morreu_em is not None:
            q = min(1.0, (self.t - self.morreu_em) / 1.2)
            tela.desenhar(spr, sx, sy + q * T * 0.3, (0, 0, 0), 0.4 + 0.5 * q)
            return
        tela.sombra(cam.tx(hx + 0.5), cam.ty(hy + 0.95), T * 0.4, max(1, T * 0.1))
        tela.desenhar(spr, sx, sy)
        if self.oleo > 0:
            chama(tela, sx + spr.ponta[0], sy + spr.ponta[1], max(1.0, T * 0.18 * (0.6 + 0.4 * self.oleo / 100)),
                  self.t, 3)

    def _hud(self, tela):
        s = 1 if tela.H < 90 else 2
        for k in range(self.VIDA):
            c = coracao(5 * s)
            tela.desenhar(c, 2 + k * 6 * s, 2, None if k < self.vida else (20, 20, 30), 0.85)
        bx, by, bw = 2, 3 + 6 * s, 30 * s
        tela.retangulo(bx, by, bx + bw, by + 2 * s, (30, 20, 20))
        cheio = bw * self.oleo / self.COMBUSTIVEL
        tela.retangulo(bx, by, bx + cheio, by + 2 * s, (255, 150, 40) if self.oleo > 25 else (220, 60, 30))
        tela.retangulo(bx, by, bx + cheio, by + max(1, s // 2), (255, 220, 140))
        hud_texto(tela, f"{self.pontos():06d}", tela.W - 2, 2, s, (255, 230, 140), direita=True)
        hud_texto(tela, f"ANDAR {self.andar.numero}", tela.W - 2, 3 + 6 * s, s, (200, 200, 230), direita=True)
        if self.t - self.t_msg < 2.5:
            tela.texto(tela.rows - 1, self.msg, lerp_cor((255, 255, 255), (90, 90, 110), (self.t - self.t_msg) / 2.5))
        elif self.t < 5:
            tela.texto(tela.rows - 1, self.dicas, (200, 200, 220))


