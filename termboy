CORES_RIVAIS = [(40, 96, 220), (250, 200, 40), (60, 180, 90), (240, 240, 240), (150, 70, 200), (255, 130, 30)]


class TurboAsfalto(Jogo):
    """Corrida em 3 faixas na pista pseudo-3D: troque de faixa e ultrapasse sem bater."""

    nome, titulo, abertura = "turbo", "Turbo Asfalto", "turbo"
    dicas = "←/→ troca de faixa   p pausa   q sai"
    Z_CARRO = 1.15     # profundidade (1/p) do nosso carro na tela
    ESCALA_Z = 2.2     # distância na pista → profundidade
    LONGE = 40.0       # onde os rivais aparecem
    INTERVALO = 0.95   # segundos mínimos entre fileiras

    def iniciar(self, semente):
        super().iniciar(semente)
        self.pos, self.vel = 0.0, 6.0
        self.faixa, self.faixa_vis = 0, 0.0
        self.rivais = []       # [d, faixa, cor, vel, contado]
        self.proxima = 12.0    # distância (na pista) até a próxima fileira
        self.ultrapassou = 0
        self.batida = None
        self.cam = Camera()

    def pontos(self):
        return int(self.pos * 2) + 25 * self.ultrapassou

    def atualizar(self, dt, ent):
        super().atualizar(dt, ent)
        self.cam.atualizar(dt, self.rng)
        if self.batida is not None:
            self.vel = max(0.0, self.vel - dt * 12)
            self.pos += self.vel * dt
            return "fim" if self.t - self.batida > 1.6 else None
        if ent.apertou("esquerda"):
            self.faixa = max(-1, self.faixa - 1)
        if ent.apertou("direita"):
            self.faixa = min(1, self.faixa + 1)
        self.faixa_vis += max(-dt * 7, min(dt * 7, self.faixa - self.faixa_vis))
        self.vel = min(14.0, 6.0 + self.t * 0.05)
        self.pos += self.vel * dt
        self.proxima -= self.vel * dt
        if self.proxima <= 0:
            self._fileira()
        for r in self.rivais:
            r[0] -= (self.vel - r[3]) * dt
            if not r[4] and r[0] < -0.4:
                r[4] = True
                self.ultrapassou += 1
        self.rivais = [r for r in self.rivais if r[0] > -3]
        for r in self.rivais:
            if -0.12 < r[0] < 0.18 and abs(r[1] - self.faixa_vis) < 0.55:
                self.batida = self.t
                self.cam.tremer(1.5)
                break
        return None

    def _fileira(self):
        """Uma fileira de 1 ou 2 rivais, todos a meia velocidade: as fileiras chegam até nós
        no mesmo ritmo em que nasceram. Sempre sobra uma faixa livre, e entre fileiras há
        pelo menos INTERVALO segundos, tempo de atravessar a pista inteira."""
        r = self.rng
        n = 2 if r.random() < min(0.6, 0.15 + self.t * 0.01) else 1
        for faixa in r.sample((-1, 0, 1), n):
            self.rivais.append([self.LONGE, faixa, r.choice(CORES_RIVAIS), self.vel * 0.5, False])
        self.proxima = self.vel * max(self.INTERVALO, r.uniform(1.4, 2.4) - self.t * 0.004)

    def _tela(self, d):
        """Fração de profundidade p (0 no horizonte, 1 embaixo) de um rival a d à frente."""
        return 1 / (self.Z_CARRO + max(0.0, d) * self.ESCALA_Z) if d > -1 else 1.2

    def desenhar(self, tela):
        W, H = tela.W, tela.H
        self.cam.ajustar(tela)
        hz = int(H * 0.42)
        curva = math.sin(self.pos * 0.02) * 0.8
        turbo_pista(tela, self.pos, curva, hz)

        def lugar(p, faixa):
            meia = W * 0.03 + p * W * 0.5
            cx = W / 2 + curva * W * 0.7 * (1 - min(p, 1)) ** 2
            return cx + faixa * meia * 0.64, hz + p * (H - hz)

        cw = int(min(W * 0.24, H * 0.6))
        for d, faixa, cor, _, _ in sorted(self.rivais, key=lambda r: -r[0]):
            p = self._tela(d)
            if p < 0.04:
                continue
            x, y = lugar(p, faixa)
            w = max(6, cw * p / (1 / self.Z_CARRO))
            if y - w * 0.5 < H:
                tela.sombra(x, y, w * 0.5, max(1, w * 0.06), 0.4)
                tela.desenhar(carro(int(w), cor), x - w / 2, y - w * 0.5)
        p0 = 1 / self.Z_CARRO
        x, y = lugar(p0, self.faixa_vis)
        x += self.cam.dx * cw * 0.2
        y = min(y, H - cw * 0.5 - 1) + (int(self.t * 12) % 2 if self.batida is None else 0)
        tela.sombra(x, H - 1, cw * 0.5, max(1, cw * 0.06), 0.4)
        inclina = (self.faixa - self.faixa_vis) * 0.3
        tela.desenhar(carro(cw, (220, 36, 48)), x - cw / 2 + inclina * cw, y)
        for fx in (0.17, 0.83):
            tela.brilho(x - cw / 2 + cw * fx, y + cw * 0.28, cw * 0.12, (255, 60, 60), 0.5)
        if self.batida is not None:
            q = (self.t - self.batida) / 1.0
            explosao(tela, x, y + cw * 0.25, min(0.99, q), cw * 0.6)
            if q < 0.3:
                tela.flash(0.8 * (1 - q / 0.3))
        s = 1 if H < 90 else 2
        hud_texto(tela, f"{self.pontos():06d}", 2, 2, s, (255, 230, 140))
        hud_texto(tela, f"{int(self.vel * 22)}KM/H", tela.W - 2, 2, s, (180, 220, 255), direita=True)
        if self.t < 4:
            tela.texto(tela.rows - 1, self.dicas, (255, 255, 255))


