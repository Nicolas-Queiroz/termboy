def hud_texto(tela, txt, x, y, s=1, cor=(255, 255, 255), contorno=(20, 12, 30), direita=False):
    """Texto na fonte 5×5 com contorno, para pontuação. direita: x é a borda direita."""
    larg = (len(txt) * 6 - 1) * s
    if direita:
        x -= larg
    for n, ch in enumerate(txt):
        cx = x + n * 6 * s
        for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1), (1, 1)):
            tela.letra(ch, cx + dx, y + dy, s, contorno)
        tela.letra(ch, cx, y, s, cor)
    return larg


