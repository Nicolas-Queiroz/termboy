@functools.lru_cache(maxsize=32)
def fofolume(h, piscando=False):
    """Bolinha fofa com uma estrela flutuando na cabeça."""
    w = h
    s = Spr(w, h)
    creme = [(150, 118, 95), (205, 183, 152), (240, 228, 200), (255, 250, 236)]
    pe = [(120, 90, 70), (170, 140, 110), (205, 178, 148)]
    s.elipse(w * 0.32, h * 0.92, w * 0.12, h * 0.07, pe)
    s.elipse(w * 0.68, h * 0.92, w * 0.12, h * 0.07, pe)
    s.elipse(w * 0.5, h * 0.6, w * 0.42, h * 0.34, creme)
    cx, cy, R = w * 0.5, h * 0.17, h * 0.16
    pts = []
    for k in range(10):
        a = -math.pi / 2 + k * math.pi / 5
        r = R if k % 2 == 0 else R * 0.45
        pts.append((cx + r * math.cos(a), cy + r * math.sin(a)))
    s.poligono(pts, [(205, 135, 25), (240, 185, 45), (255, 222, 85), (255, 246, 175)])
    s.contorno((60, 40, 32))
    for ex in (0.36, 0.64):
        if piscando:
            y = int(h * 0.6)
            for x in range(int(w * ex - w * 0.06), int(w * ex + w * 0.06) + 1):
                s.px[(x, y)] = (25, 20, 35)
        else:
            olho = s.elipse(w * ex, h * 0.58, w * 0.06, h * 0.09, cor=(25, 20, 35))
            if olho and h >= 14:
                s.px[min(olho, key=lambda p: (p[1], p[0]))] = (255, 255, 255)
    for bx in (0.22, 0.78):
        s.elipse(w * bx, h * 0.7, w * 0.06, h * 0.035, cor=(245, 145, 165))
    my, mx = int(h * 0.73), int(w * 0.5)
    for dx in (-1, 0):
        s.px[(mx + dx, my)] = (125, 50, 60)
    return s


@functools.lru_cache(maxsize=32)
def cubrasa(h, asa=0):
    """Cubo alado de um olho só."""
    w = h
    s = Spr(w, h)
    ramp_asa = [(50, 28, 80), (82, 48, 122), (118, 76, 165)]
    sobe = -0.06 * h if asa else 0
    for lado in (1, -1):
        X = lambda u: w * 0.5 + lado * (u - 0.5) * w
        pts = [(X(0.3), h * 0.36), (X(0.02), h * 0.1 + sobe), (X(0.08), h * 0.34 + sobe),
               (X(0.0), h * 0.5 + sobe), (X(0.1), h * 0.52), (X(0.06), h * 0.66), (X(0.3), h * 0.62)]
        s.poligono(pts, ramp_asa)
        s.poligono([(X(0.3), h * 0.25), (X(0.25), h * 0.07), (X(0.41), h * 0.25)],
                   [(70, 45, 45), (120, 88, 76), (170, 140, 118)])
    corpo = [(48, 52, 138), (78, 88, 188), (112, 124, 230), (162, 172, 252)]
    x0, x1, y0, y1 = w * 0.26, w * 0.74, h * 0.22, h * 0.84
    rr = w * 0.08
    for y in range(int(y0), int(y1)):
        for x in range(int(x0), int(x1)):
            cx = min(max(x + 0.5, x0 + rr), x1 - rr)
            cy = min(max(y + 0.5, y0 + rr), y1 - rr)
            if (x + 0.5 - cx) ** 2 + (y + 0.5 - cy) ** 2 > rr * rr:
                continue
            u, v = (x - x0) / (x1 - x0), (y - y0) / (y1 - y0)
            d = 1 - (0.6 * u + 0.4 * v) + (0.25 if (u < 0.12 or v < 0.08) else 0)
            s.px[(x, y)] = corpo[max(0, min(3, int(d * 4)))]
    for fx in (0.36, 0.64):
        s.ret(w * fx - w * 0.04, h * 0.84, w * fx + w * 0.04 + 1, h * 0.95, (40, 36, 92))
    s.contorno((24, 14, 44))
    s.elipse(w * 0.5, h * 0.47, w * 0.15, h * 0.13, cor=(238, 238, 250))
    iris = s.elipse(w * 0.5, h * 0.47, w * 0.09, h * 0.1, [(150, 20, 30), (220, 52, 52), (255, 112, 92)])
    s.elipse(w * 0.5, h * 0.48, w * 0.035, h * 0.055, cor=(20, 10, 20))
    if iris and h >= 14:
        s.px[min(iris, key=lambda p: (p[1], p[0]))] = (255, 255, 255)
    for x in range(int(w * 0.43), int(w * 0.57) + 1):
        s.px[(x, int(h * 0.7))] = (30, 22, 70)
    return s


TUFOS = [(RNG.random(), RNG.random()) for _ in range(40)]
NUVENS = [(RNG.random(), 0.08 + RNG.random() * 0.25, 0.5 + RNG.random() * 0.6) for _ in range(5)]


def montanhas(tela, base, alt, off, cor, seed, neve=None):
    W = tela.W

    def h(x):
        u = (x + off) / max(1, W) * 6.283
        return alt * (0.6 + 0.22 * math.sin(u * 1.3 + seed) + 0.13 * math.sin(u * 3.1 + seed * 2.1)
                      + 0.05 * math.sin(u * 7.7 + seed * 3.3))

    c_luz, c_sombra = tela.c(clarear(cor, 0.14)), tela.c(cor)
    c_neve = tela.c(neve) if neve else None
    for x in range(W):
        hx = h(x)
        topo = int(base - hx)
        c = c_luz if h(x + 1) > hx else c_sombra
        for y in range(max(0, topo), min(tela.H, int(base) + 1)):
            tela.px[y][x] = c_neve if (neve and y < topo + max(1, alt * 0.14) and hx > alt * 0.74) else c


def nuvens(tela, t, vel=1.5):
    for fx, fy, k in NUVENS:
        r = max(1.5, tela.H * 0.05 * k)
        cx = (fx * (tela.W + 6 * r) + t * vel * k) % (tela.W + 6 * r) - 3 * r
        cy = fy * tela.H
        for dx, dy, f in ((-r * 0.9, r * 0.25, 0.7), (r * 0.9, r * 0.3, 0.75), (0, 0, 1.0), (r * 0.35, -r * 0.4, 0.65)):
            ccx, ccy, rr = cx + dx, cy + dy, r * f
            for y in range(int(ccy - rr), int(ccy + rr) + 1):
                for x in range(int(ccx - rr), int(ccx + rr) + 1):
                    if (x + 0.5 - ccx) ** 2 + (y + 0.5 - ccy) ** 2 <= rr * rr:
                        tela.ponto(x, y, (255, 255, 255) if y < cy + r * 0.25 else (206, 218, 238))


def gramado(tela, off, gy, c1=(66, 142, 58), c2=(112, 192, 82)):
    for y in range(max(0, gy), tela.H):
        p = (y - gy) / max(1, tela.H - gy)
        base = tela.c(lerp_cor(c1, c2, p))
        escuro = tela.c(escurecer(lerp_cor(c1, c2, p), 0.14))
        linha = tela.px[y]
        o = int(off * (0.5 + p)) + y * 3
        for x in range(tela.W):
            linha[x] = escuro if (x + o) % 7 == 0 else base
    if 0 <= gy < tela.H:
        tela.retangulo(0, gy, tela.W, gy + 1, escurecer(c1, 0.25))
    for fx, fy in TUFOS:
        x = (fx * tela.W - off * 1.2) % tela.W
        y = gy + 2 + fy * (tela.H - gy - 3)
        tela.ponto(x, y, escurecer(c1, 0.3))
        tela.ponto(x + 1, y - 1, escurecer(c1, 0.3))


def tam_criatura(tela, teto=None):
    h = int(min(tela.H * 0.42, tela.W * 0.26))
    if teto is not None:
        h = min(h, teto)
    return max(0, min(h, 64))


CEU_NOITE = [(0, (2, 3, 16)), (0.65, (22, 16, 62)), (1, (60, 32, 95))]
CEU_DIA = [(0, (64, 120, 225)), (0.6, (145, 196, 250)), (1, (222, 240, 255))]
CEU_POR = [(0, (36, 18, 86)), (0.35, (148, 58, 118)), (0.62, (248, 128, 70)), (1, (255, 214, 125))]


def elementra(tela, t):
    if t < 4.0:
        tela.ceu(CEU_NOITE)
        estrelas(tela, t, 0.8)
        lx, ly, lr = tela.W * 0.8, tela.H * 0.22, max(2, tela.H * 0.09)
        tela.brilho(lx, ly, lr * 3, (200, 210, 255), 0.35)
        tela.circulo(lx, ly, lr, (235, 235, 220))
        tela.circulo(lx - lr * 0.3, ly - lr * 0.2, lr * 0.25, (205, 205, 195))
        tela.circulo(lx + lr * 0.35, ly + lr * 0.3, lr * 0.18, (205, 205, 195))
        montanhas(tela, tela.H, tela.H * 0.22, t * 2, (18, 14, 40), 1.0)
        p = (t - 0.4) / 2.2
        if 0 <= p <= 1:
            x0, y0, x1, y1 = tela.W * 1.05, tela.H * 0.02, tela.W * 0.15, tela.H * 0.6
            for k in range(18):
                q = p - k * 0.01
                if q < 0:
                    break
                x, y = lerp(x0, x1, q), lerp(y0, y1, q)
                tela.misturar(x, y, (255, 250, 210), 1 - k / 18)
                tela.misturar(x, y + 1, (180, 160, 255), 0.6 * (1 - k / 18))
            tela.brilho(lerp(x0, x1, p), lerp(y0, y1, p), 4, (255, 255, 220), 0.9)
        if 1.4 <= t <= 3.9:
            a = min(1, (t - 1.4) / 0.5, (3.9 - t) / 0.5)
            tela.texto(tela.rows // 2, "uma produção TERMINAL", lerp_cor((22, 16, 62), (230, 230, 255), a))
        return

    if t < 12.0:
        pan = (1 - ease((t - 4) / 2.0)) * tela.W * 0.6
        tela.ceu(CEU_DIA)
        tela.brilho(tela.W * 0.15, tela.H * 0.12, tela.H * 0.3, (255, 250, 210), 0.5)
        nuvens(tela, t)
        gy = int(tela.H * 0.74)
        montanhas(tela, gy, tela.H * 0.4, pan * 0.2 + 10, (120, 150, 200), 0.5, neve=(240, 245, 255))
        montanhas(tela, gy, tela.H * 0.22, pan * 0.5 + 40, (70, 130, 90), 2.3)
        gramado(tela, pan, gy)
        h = tam_criatura(tela)
        if h < 8:
            return
        xa_f, xb_f = tela.W * 0.27 - h / 2, tela.W * 0.73 - h / 2
        e = ease((t - 4.2) / 1.5)
        xa, xb = lerp(-h * 1.2, xa_f, e), lerp(tela.W + h * 0.2, xb_f, e)
        ya = yb = gy - h + max(1, h // 10)
        if 5.7 <= t < 10.0:
            ya -= abs(math.sin((t - 5.7) * 5)) * h * 0.08
            yb -= abs(math.sin((t - 5.7) * 5 + 1.4)) * h * 0.08
        dano = 9.0 <= t < 9.8
        if dano:
            xb += math.sin(t * 60) * h * 0.06 + h * 0.15 * (1 - (t - 9.0) / 0.8)
        if t >= 10.0:
            c = ease((t - 10.0) / 1.2)
            xa, xb = lerp(xa_f, tela.W / 2 - h * 0.95, c), lerp(xb_f, tela.W / 2 - h * 0.05, c)
        tela.sombra(xa + h / 2, gy + 1, h * 0.4, max(1, h * 0.08))
        tela.sombra(xb + h / 2, gy + 1, h * 0.35, max(1, h * 0.08))
        if 7.0 <= t < 8.0:
            tela.brilho(xa + h / 2, ya + h * 0.6, h * (0.7 + 0.2 * math.sin(t * 25)), (255, 230, 120), 0.6)
        tela.desenhar(fofolume(h, (t % 2.7) < 0.12), xa, ya)
        tinta = (255, 80, 80) if dano and int(t * 15) % 2 == 0 else None
        tela.desenhar(cubrasa(h, int(t * 6) % 2), xb, yb, tinta)
        if 8.0 <= t < 9.0:
            q = ease((t - 8.0) / 1.0)
            for k in range(1, 6):
                qq = max(0, q - k * 0.05)
                tela.brilho(lerp(xa + h * 0.8, xb + h * 0.3, qq), ya + h * 0.55 - math.sin(qq * math.pi) * h * 0.3,
                            h * 0.15, (255, 220, 120), 0.5 * (1 - k / 6))
            ox, oy = lerp(xa + h * 0.8, xb + h * 0.3, q), ya + h * 0.55 - math.sin(q * math.pi) * h * 0.3
            tela.brilho(ox, oy, h * 0.4, (255, 235, 150), 0.9)
            tela.circulo(ox, oy, max(1, h * 0.08), (255, 255, 240))
        if 9.0 <= t < 10.0:
            q = t - 9.0
            cx, cy = xb_f + h * 0.4, ya + h * 0.5
            for k in range(14):
                ang = k * 2 * math.pi / 14 + 0.3
                d = q * h * (1.0 + 0.4 * (k % 3))
                tela.brilho(cx + math.cos(ang) * d, cy + math.sin(ang) * d * 0.7, max(1.5, h * 0.06),
                            (255, 200, 90) if k % 2 else (255, 255, 230), 1 - q)
        if t >= 11.2:
            a = (t - 11.2) / 0.8
            if int(t * 15) % 2 == 0 or a > 0.6:
                tela.flash(max(a, 0.7))
        return

    tela.ceu(CEU_POR)
    sx, sy = tela.W * 0.5, tela.H * 0.62
    for y in range(int(sy) + 1):
        for x in range(tela.W):
            if (math.atan2(y - sy, x - sx) * 12 / (2 * math.pi) + t * 0.25) % 1 < 0.5:
                tela.misturar(x, y, (255, 240, 200), 0.13)
    estrelas(tela, t, limite=0.18)
    tela.brilho(sx, sy, tela.H * 0.4, (255, 225, 150), 0.6)
    tela.circulo(sx, sy, max(2, tela.H * 0.11), (255, 238, 175))
    gy = int(tela.H * 0.78)
    montanhas(tela, gy, tela.H * 0.32, t * 1.5, (92, 48, 110), 0.8)
    montanhas(tela, gy, tela.H * 0.18, t * 4, (58, 30, 78), 2.9)
    gramado(tela, t * 8, gy, (40, 70, 60), (70, 110, 80))
    if t < 12.4:
        tela.flash(1 - (t - 12.0) / 0.4)
    fim = titulo(tela, ["ELEMENTRA"], t, 12.2, [(255, 246, 150), (240, 110, 30)])
    h = tam_criatura(tela, teto=gy - fim - 4)
    if h >= 8 and t >= 13.0:
        sobe = (1 - ease((t - 13.0) / 0.8)) * h
        tela.sombra(tela.W * 0.16 + h / 2, gy + 1, h * 0.4, max(1, h * 0.08))
        tela.sombra(tela.W * 0.84 - h / 2, gy + 1, h * 0.35, max(1, h * 0.08))
        tela.desenhar(fofolume(h, (t % 3.1) < 0.12), tela.W * 0.16, gy - h + max(1, h // 10) + sobe)
        tela.desenhar(cubrasa(h, int(t * 5) % 2), tela.W * 0.84 - h, gy - h + max(1, h // 10) + sobe)
    for k in range(8):
        fase = (t * 0.6 + k * 0.137) % 1
        px = ((k * 0.31 + 0.05) % 1) * tela.W
        tela.brilho(px + math.sin(t * 2 + k) * 2, lerp(gy, tela.H * 0.05, fase), 1.6, (255, 250, 210), 0.9 * (1 - fase))
    versao = {"gb": "VERSÃO MUSGO", "gbc": "VERSÃO BRASA", "gba": "VERSÃO MARÉ"}[tela.estilo]
    rodape(tela, t, 13.6, versao, fim // 2 + 1, 14.4)

